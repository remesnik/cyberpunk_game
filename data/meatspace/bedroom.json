{
  "id": "BEDROOM",
  "objects": {
    "BED": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "It hasn't been made in a while."
        },
        {
          "id": "SLEEP",
          "text": "You wake rested. The light beyond the blinds has changed.",
          "actions": [
            {
              "type": "REST",
              "amount": 60
            },
            {
              "type": "ADVANCE_TIME",
              "steps": 1
            }
          ]
        }
      ]
    },
    "DESK": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "Your primary hardware bench. Solder burns, cable scars, and just enough clear space for the next repair."
        }
      ]
    },
    "STARTER_DECK_BOX": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "A shipping carton with starter supplies tucked beneath folded packing paper."
        },
        {
          "id": "OPEN",
          "when_flag": "BOX_OPEN",
          "equals": false,
          "text": "The packing tape gives way. Useful spares sit inside.",
          "actions": [
            {
              "type": "SET_FLAG",
              "id": "BOX_OPEN",
              "value": true
            }
          ]
        },
        {
          "id": "TAKE",
          "when_flag": "BOX_EMPTIED",
          "equals": false,
          "text": "You pocket the spare leads and repair notes. The carton is empty.",
          "actions": [
            {
              "type": "TAKE_CONTENTS",
              "id": "STARTER_DECK_BOX"
            },
            {
              "type": "SET_FLAG",
              "id": "BOX_OPEN",
              "value": true
            },
            {
              "type": "SET_FLAG",
              "id": "BOX_EMPTIED",
              "value": true
            }
          ]
        }
      ],
      "contents": [
        {
          "id": "SPARE_LEADS",
          "name": "Spare interface leads",
          "visual": "SMALL_CASE"
        },
        {
          "id": "REPAIR_NOTES",
          "name": "Folded repair notes",
          "visual": "BOOK"
        }
      ],
      "visual_state": {
        "open": "BOX_OPEN",
        "empty": "BOX_EMPTIED"
      }
    },
    "TOOLBOX": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "A battered steel case. The handle has outlasted two sets of tools."
        },
        {
          "id": "OPEN",
          "when_flag": "TOOLBOX_OPEN",
          "equals": false,
          "text": "The lid creaks open over neatly nested tools.",
          "actions": [
            {
              "type": "SET_FLAG",
              "id": "TOOLBOX_OPEN",
              "value": true
            }
          ]
        }
      ],
      "visual_state": {
        "open": "TOOLBOX_OPEN"
      }
    },
    "DISPLAY_TABLE": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "This would be a good place to put things I don't want to lose."
        }
      ],
