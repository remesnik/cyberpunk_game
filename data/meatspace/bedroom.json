    "BOOKSHELF": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "Repair manuals lean against photocopied zines. A pencilled note reads: never trust the pinout."
        },
        {
          "id": "READ",
          "text": "Field repairs, volume II: the useful pages are held together with tape."
        }
      ],
      "entries": [
        {
          "id": "MANUAL",
          "title": "Field repairs, volume II",
          "text": "The useful pages are held together with tape."
        }
      ]
    },
    "WINDOW": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "Venetian blinds stripe the skyline. Beyond the glass: rooftop utilities, signal towers, and a city that never quite sleeps."
        },
        {
          "id": "OPEN",
          "when_flag": "WINDOW_OPEN",
          "equals": false,
          "text": "You tilt the sash open. Traffic and rooftop wind become clearer.",
          "actions": [
            {
              "type": "SET_FLAG",
              "id": "WINDOW_OPEN",
              "value": true
            }
          ]
        },
        {
          "id": "CLOSE",
          "when_flag": "WINDOW_OPEN",
          "equals": true,
          "text": "The latch catches. The city falls back to a muffled hum.",
          "actions": [
            {
              "type": "SET_FLAG",
              "id": "WINDOW_OPEN",
              "value": false
            }
          ]
        }
      ],
      "visual_state": {
        "open": "WINDOW_OPEN"
      }
    },
    "POSTER_VIRUS": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "VIRUS // Replicate. Mutate. A bootleg print celebrating exploits, destructive code, and programmers who sign their work in crash dumps."
        }
      ]
    },
    "POSTER_PHREAKER": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "PHREAKERS // The line is ours. Switching diagrams, radio frequencies, and a reminder that every network starts with physical wire."
        }
      ]
    },
    "POSTER_WAREZ": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "WAREZ // Copy. Keep. Share. A release-group emblem from the nights of cracked software, traded disks, and BBS upload ratios."
        }
      ]
    },
    "JACK_IN_INTERFACE": {
      "verbs": [
        {
          "id": "EXAMINE",
          "text": "A terminal, isolation switch, and coiled interface lead. Your connection to the local board."
        }
      ]
    }
