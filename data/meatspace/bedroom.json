              "type": "SET_FLAG",
              "id": "WINDOW_OPEN",
              "value": true
            }
          ]
        },
        {
          "id": "CLOSE",
          "when_flag": "WINDOW_OPEN",
          "equals": true,
          "text": "The latch catches. The city falls back to a muffled hum.",
          "actions": [
            {
              "type": "SET_FLAG",
              "id": "WINDOW_OPEN",
              "value": false
            }
          ]
        },
        {
          "id": "RAISE_BLINDS",
          "when_flag": "WINDOW_BLINDS_RAISED",
          "equals": false,
          "text": "The blinds gather above the glass, exposing the skyline.",
          "actions": [{"type": "SET_FLAG", "id": "WINDOW_BLINDS_RAISED", "value": true}]
        },
        {
          "id": "LOWER_BLINDS",
          "when_flag": "WINDOW_BLINDS_RAISED",
          "equals": true,
          "text": "The blinds settle back into pale horizontal stripes.",
          "actions": [{"type": "SET_FLAG", "id": "WINDOW_BLINDS_RAISED", "value": false}]
        }
      ],
      "visual_state": {
