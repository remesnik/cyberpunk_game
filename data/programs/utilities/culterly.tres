[gd_resource type="Resource" script_class="PassiveUtilityDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://programs/PassiveUtilityDefinition.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"CULTERLY"
