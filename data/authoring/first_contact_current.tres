[gd_resource type="Resource" script_class="CyberspaceContentDocument" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/authoring/CyberspaceContentDocument.gd" id="1"]

[resource]
script = ExtResource("1")
document_id = &"FIRST_CONTACT"
title = "First Contact"
summary = "A short training intrusion into an old office subnet, teaching node-controlled directional routes through real gameplay events."
tags = Array[StringName]([&"INTRODUCTION", &"TUTORIAL", &"NODE_CONTROLLED_PATHS"])
tutorial_guidance_rules = [{"id":&"FC_COMMS_ENTER_NODE_MODE","sequence_insertion":true,"insert_after":&"FC_REACH_COMMS","beat":{"id":&"FC_COMMS_NODE_MODE","dialogue":[{"speaker_id":&"LATCH","text":"COMMS has a live voice object. Enter Node Mode and identify it."}],"objective":{"id":&"ENTER_COMMS_NODE_MODE","title":"ENTER NODE MODE AT COMMS"},"completion":{"event_type":&"NODE_MODE_ENTERED","target_id":&"COMMS"},"require_fresh_event":true}},{"id":&"FC_COMMS_SCAN_SESSION","sequence_insertion":true,"insert_after":&"FC_COMMS_NODE_MODE","beat":{"id":&"FC_SCAN_OFFICE_FEED","objective":{"id":&"SCAN_OFFICE_FEED","title":"SCAN THE ACTIVE VOICE SESSION","action_type":&"SCAN","target_id":&"OFFICE_FEED"},"completion":{"event_type":&"TARGET_SCANNED","target_id":&"OFFICE_FEED"},"require_fresh_event":true}},{"id":&"FC_COMMS_RETURN_NETWORK","sequence_insertion":true,"insert_after":&"FC_MONITOR_FEED","beat":{"id":&"FC_LEAVE_COMMS_NODE_MODE","dialogue":[{"speaker_id":&"LATCH","text":"Leave Node Mode. The call keeps running in real time while you move."}],"objective":{"id":&"LEAVE_COMMS_NODE_MODE","title":"RETURN TO NETWORK MODE WHILE MONITORING"},"completion":{"event_type":&"NETWORK_MODE_ENTERED","target_id":&"COMMS"},"require_fresh_event":true}},{"id":&"FC_SECURITY_TRAVERSE_OVERRIDE","sequence_beat_override":&"FC_REACH_SECURITY","patch":{"objective":{"id":&"REACH_SECURITY","title":"TRAVERSE TO SECURITY WHILE THE CALL CONTINUES","action_type":&"MOVE","target_id":&"SECURITY"},"require_fresh_event":true}}]
availability = "STORY_ONLY"
data_tutorial_insertions = [{"insert_after":&"FC_TRAVERSE_REMOTE_DATA","beat":{"id":&"FC_DATA_NODE_MODE","dialogue":[{"speaker_id":&"LATCH","text":"That's the datastore. Your deck has limited storage; inspect the file before you copy it."}],"objective":{"id":&"ENTER_DATA_NODE_MODE","title":"ENTER NODE MODE AT DATA"},"completion":{"event_type":&"NODE_MODE_ENTERED","target_id":&"DATA"},"require_fresh_event":true}},{"insert_after":&"FC_DATA_NODE_MODE","beat":{"id":&"FC_DISCOVER_TRAINING_FILE","objective":{"id":&"DISCOVER_TRAINING_FILE","title":"SCAN LATCH_TRAINING.DAT","action_type":&"SCAN","target_id":&"TRAINING_FILE_OBJECT"},"completion":{"event_type":&"TARGET_SCANNED","target_id":&"TRAINING_FILE_OBJECT"},"require_fresh_event":true}},{"insert_after":&"FC_DISCOVER_TRAINING_FILE","beat":{"id":&"FC_INSPECT_TRAINING_FILE","dialogue":[{"speaker_id":&"LATCH","text":"Check its size against your deck storage. The storage model carries more data; the slots model keeps more programs active."}],"objective":{"id":&"INSPECT_TRAINING_FILE","title":"INSPECT THE FILE AND STORAGE CAPACITY","action_type":&"ANALYZE","target_id":&"TRAINING_FILE_OBJECT"},"completion":{"event_type":&"DATA_OBJECT_INSPECTED","target_id":&"TRAINING_FILE_OBJECT"},"require_fresh_event":true}}]
data_objects = [{"id":&"TRAINING_FILE_OBJECT","story_id":&"TRAINING_FILE","display_name":"LATCH_TRAINING.DAT","node_id":&"DATA","object_type":&"FILE","size_units":2,"description":"The small route manifest Latch planted for the training run.","downloadable":true,"one_time":true,"on_download":[{"type":&"INCREASE_TRACE","amount":2},{"type":&"INCREASE_SLEEVE_ALERT","sleeve_id":&"OFFICE_SECURITY_SLEEVE","amount":1},{"type":&"SET_PATH_STATE","link_id":&"SECURITY_DATA","source":&"DATA","destination":&"SECURITY","state":&"LOCKED_DOWN","reason":"SECURITY LOCKDOWN: RETURN ROUTE REVOKED"}],"tags":[&"OBJECTIVE",&"FIRST_CONTACT"]}]
escalation_tutorial_insertions = [{"insert_after":&"FC_ACQUIRE_FILE","beat":{"id":&"FC_DYNAMIC_LOCKDOWN","dialogue":[{"speaker_id":&"LATCH","text":"There it is. Unlocked does not necessarily mean permanently unlocked. Your obvious return path just locked down—read the graph and use the remaining route."}],"objective":{"id":&"ASSESS_DYNAMIC_LOCKDOWN","title":"ASSESS THE CHANGED NETWORK ROUTES"},"completion":{"event_type":&"SECURITY_ESCALATION_APPLIED","target_id":&"SECURITY_DATA"}}}]
final_tutorial_insertions = [{"insert_after":&"FC_JACK_BACK_IN","beat":{"id":&"FC_INSPECT_ACCESS_LOG","dialogue":[{"speaker_id":&"LATCH","text":"Return route worked. One last thing: find the access log and scrub our trail."}],"objective":{"id":&"FIND_ACCESS_LOG","title":"SCAN THE ACCESS LOG","action_type":&"SCAN","target_id":&"ACCESS_LOG"},"completion":{"event_type":&"TARGET_SCANNED","target_id":&"ACCESS_LOG"},"require_fresh_event":true}},{"insert_after":&"FC_INSPECT_ACCESS_LOG","beat":{"id":&"FC_FINAL_CLEANUP","dialogue":[{"speaker_id":&"LATCH","text":"Disable it, then take the exit. Routes, defenses, live systems, and a way home—that's the job."}],"objective":{"id":&"SCRUB_ACCESS_LOG","title":"DISABLE THE ACCESS LOG","action_type":&"DISABLE","target_id":&"ACCESS_LOG"},"completion":{"event_type":&"SERVICE_DISABLED","target_id":&"ACCESS_LOG"},"require_fresh_event":true}}]
hard_gate_tutorial_insertions = [{"insert_after":&"FC_BACKTRACK_SECURITY","beat":{"id":&"FC_INSPECT_DATA_WARDEN","dialogue":[{"speaker_id":&"LATCH","text":"Watcher cared that you passed. Warden won't let you pass. Soft gate means consequences; hard gate means no traversal until the defense is resolved."}],"objective":{"id":&"INSPECT_DATA_WARDEN","title":"INSPECT THE DATA WARDEN","target_id":&"DATA_WARDEN"},"completion":{"operator":&"ANY","events":[{"event_type":&"ICE_INSPECTED","target_id":&"DATA_WARDEN"},{"event_type":&"TARGET_SCANNED","target_id":&"DATA_WARDEN"}]},"require_fresh_event":true}},{"insert_after":&"FC_INSPECT_DATA_WARDEN","beat":{"id":&"FC_RESOLVE_DATA_WARDEN","objective":{"id":&"RESOLVE_DATA_WARDEN","title":"BYPASS, DISABLE, OR DEFEAT THE WARDEN","target_id":&"DATA_WARDEN","choices":[&"BYPASS",&"DISRUPT",&"ATTACK"]},"completion":{"operator":&"ANY","events":[{"event_type":&"ICE_DEFEATED","target_id":&"DATA_WARDEN"},{"event_type":&"ICE_BYPASSED","target_id":&"DATA_WARDEN"}]},"require_fresh_event":true}}]
tutorial_beat_overrides = {&"FC_REMOTE_ROUTE":{"dialogue":[{"speaker_id":&"LATCH","text":"Compromise the routing control here. It will remotely unlock SECURITY to DATA."}],"objective":{"id":&"OPEN_REMOTE_DATA_ROUTE","title":"COMPROMISE THE ROUTE CONTROL SYSTEM","action_type":&"DISABLE","target_id":&"ROUTE_CONTROL"},"completion":{"event_type":&"OUTBOUND_ROUTE_UNLOCKED","target_id":&"DATA"},"require_fresh_event":true},&"FC_ACQUIRE_FILE":{"objective":{"id":&"ACQUIRE_TRAINING_FILE","title":"ACQUIRE THE TRAINING FILE","target_id":&"TRAINING_FILE"}},&"FC_DOORSTOP":{"dialogue":[{"speaker_id":&"LATCH","text":"Doorstop is one-shot. Deploy it here to create a temporary return point. You can jack out to meatspace and later return here once; it is not a permanent save point."}],"objective":{"id":&"DEPLOY_DOORSTOP","title":"DEPLOY THE DOORSTOP AT DATA","action_type":&"USE_PROGRAM","program_type":&"DOORSTOP","target_node_id":&"DATA"},"completion":{"event_type":&"DOORSTOP_DEPLOYED","target_id":&"DATA"},"require_fresh_event":true},&"FC_JACK_OUT":{"dialogue":[{"speaker_id":&"LATCH","text":"Return point is live. Jack out through the Doorstop and let the intrusion suspend while you return to the bedroom."}],"objective":{"id":&"JACK_OUT_DOORSTOP","title":"JACK OUT THROUGH THE TEMPORARY RETURN POINT","action_type":&"JACK_OUT_DOORSTOP","target_node_id":&"DATA"},"completion":{"event_type":&"INTRUSION_SUSPENDED_AT_DOORSTOP"},"require_fresh_event":true},&"FC_JACK_BACK_IN":{"dialogue":[{"speaker_id":&"LATCH","text":"There is one final task inside the network. Use the temporary route when you're ready; the bedroom systems are optional."}],"objective":{"id":&"JACK_BACK_IN_DOORSTOP","title":"JACK BACK IN THROUGH THE DATA RETURN POINT","action_type":&"JACK_BACK_IN_DOORSTOP","return_node_id":&"DATA","requires_active_anchor":true},"completion":{"event_type":&"DOORSTOP_REENTRY_COMPLETED","target_id":&"DATA"},"require_fresh_event":true}}
tutorial_sequence_patches = [{"beat_id":&"FC_INSPECT_ICE","patch":{"dialogue":[{"speaker_id":&"LATCH","text":"This defense watches the route. It won't stop you, but crossing under observation will raise the response."}],"objective":{"id":&"INSPECT_WATCHER","title":"INSPECT THE ROUTE WATCHER","target_id":&"TRAINING_WATCHER"},"completion":{"operator":&"ANY","events":[{"event_type":&"ICE_INSPECTED","target_id":&"TRAINING_WATCHER"},{"event_type":&"TARGET_SCANNED","target_id":&"TRAINING_WATCHER"}]}}},{"beat_id":&"FC_RESOLVE_ICE","patch":{"dialogue":[{"speaker_id":&"LATCH","text":"Your call: bypass the Watcher, or cross the monitored route and take the heat."}],"objective":{"id":&"CHOOSE_WATCHER_APPROACH","title":"BYPASS THE WATCHER OR CROSS UNDER OBSERVATION","choices":[&"BYPASS",&"DISRUPT",&"ATTACK",&"TRAVERSE_MONITORED_ROUTE"]},"completion":{"operator":&"ANY","events":[{"event_type":&"ICE_DEFEATED","target_id":&"TRAINING_WATCHER"},{"event_type":&"ICE_BYPASSED","target_id":&"TRAINING_WATCHER"},{"event_type":&"PATH_TRAVERSED","target_id":&"CONTROL"}]}}},{"beat_id":&"FC_REACH_CONTROL","patch":{"objective":{"id":&"REACH_CONTROL","title":"TRAVERSE TO CONTROL","target_id":&"CONTROL"}}}]
tutorial_stage_insertions = [{"insert_after":&"FC_REACH_CONTROL","beat":{"id":&"FC_CONTROL_NODE_MODE","dialogue":[{"speaker_id":&"LATCH","text":"Most routes are controlled by the node you're leaving. Some are controlled elsewhere. ROUTE CONTROLLED BY CONTROL-01."}],"objective":{"id":&"ENTER_CONTROL_NODE_MODE","title":"ENTER NODE MODE AT CONTROL-01"},"completion":{"event_type":&"NODE_MODE_ENTERED","target_id":&"CONTROL"},"require_fresh_event":true}},{"insert_after":&"FC_CONTROL_NODE_MODE","beat":{"id":&"FC_SCAN_ROUTE_CONTROL","objective":{"id":&"IDENTIFY_ROUTE_CONTROL","title":"SCAN THE DATA ROUTE INTERLOCK","action_type":&"SCAN","target_id":&"ROUTE_CONTROL"},"completion":{"event_type":&"TARGET_SCANNED","target_id":&"ROUTE_CONTROL"},"require_fresh_event":true}},{"insert_after":&"FC_REMOTE_ROUTE","beat":{"id":&"FC_CONTROL_RETURN_NETWORK","dialogue":[{"speaker_id":&"LATCH","text":"Remote gate is open. No shortcut—return through the topology."}],"objective":{"id":&"LEAVE_CONTROL_NODE_MODE","title":"RETURN TO NETWORK MODE"},"completion":{"event_type":&"NETWORK_MODE_ENTERED","target_id":&"CONTROL"},"require_fresh_event":true}},{"insert_after":&"FC_CONTROL_RETURN_NETWORK","beat":{"id":&"FC_BACKTRACK_SECURITY","objective":{"id":&"BACKTRACK_TO_SECURITY","title":"BACKTRACK TO SECURITY","action_type":&"MOVE","target_id":&"SECURITY"},"completion":{"event_type":&"PATH_TRAVERSED","target_id":&"SECURITY"},"require_fresh_event":true}},{"insert_after":&"FC_BACKTRACK_SECURITY","beat":{"id":&"FC_TRAVERSE_REMOTE_DATA","objective":{"id":&"TRAVERSE_REMOTE_DATA_ROUTE","title":"TRAVERSE THE REMOTELY OPENED ROUTE TO DATA","action_type":&"MOVE","target_id":&"DATA"},"completion":{"event_type":&"PATH_TRAVERSED","target_id":&"DATA"},"require_fresh_event":true}}]
path_security_overrides = [{"link_id":&"SECURITY_CONTROL","source":&"SECURITY","destination":&"CONTROL","state":&"UNLOCKED","controller":&"SECURITY","gate_type":&"SOFT","controlling_security":{"kind":&"ICE","id":&"TRAINING_WATCHER","resolve_on":[&"ice_destroyed",&"ice_bypassed",&"ice_disrupted"]},"security_resolved":false,"blocked_reason":"TRAVERSABLE BUT MONITORED","on_unauthorized_traversal":[{"type":&"INCREASE_TRACE","amount":3,"player_visible":true},{"type":&"INCREASE_SLEEVE_ALERT","amount":1,"sleeve_id":&"OFFICE_SECURITY_SLEEVE","player_visible":true},{"type":&"MARK_PLAYER_DETECTED","ice_id":&"TRAINING_WATCHER","alert_increase":30,"player_visible":true}]},{"link_id":&"SECURITY_DATA","source":&"SECURITY","destination":&"DATA","state":&"LOCKED","controller":&"CONTROL","remote_controller":&"CONTROL","gate_type":&"HARD","controlling_security":{"kind":&"ICE","id":&"DATA_WARDEN","resolve_on":[&"ice_destroyed",&"ice_bypassed",&"ice_disrupted"]},"security_resolved":false,"blocked_reason":"WARDEN BLOCKING: RESOLVE DATA_WARDEN BEFORE TRAVERSAL"}]
security_sleeves = [{"id":&"OFFICE_SECURITY_SLEEVE","display_name":"Office Security Sleeve","current_members":[&"SECURITY",&"CONTROL",&"DATA"],"state":&"INTACT","metadata":{"response_level":0}}]
hud_guidance = {"required_sensors_level":1,"opening_network_lesson":["You're in Network Mode. Your SAN is the highlighted current node; the lines around it are visible paths.","Sensors 1 identifies the directly connected ACCESS node and sketches one more layer as unknown topology.","Unknown only means your deck can see that something is there. Seeing a node does not mean you can reach it.","The sphere map keeps that local security neighborhood visible while you navigate. Inspect the SAN, then take the open path to ACCESS."],"additional_beats":[{"insert_after":&"FC_NODE_MODE_ACCESS","beat":{"id":&"FC_IDENTIFY_ACCESS_CONTROL","dialogue":[{"speaker_id":&"LATCH","text":"The node owns the route out. Crack the node, open the path."}],"objective":{"id":&"IDENTIFY_ACCESS_CONTROL","title":"SCAN LEGACY AUTHENTICATION","action_type":&"SCAN","target_id":&"ACCESS_AUTH"},"completion":{"event_type":&"TARGET_SCANNED","target_id":&"ACCESS_AUTH"}}},{"insert_after":&"FC_UNLOCK_COMMS","beat":{"id":&"FC_RETURN_TO_NETWORK","dialogue":[{"speaker_id":&"LATCH","text":"Route is open. Return to Network Mode, then move on."}],"objective":{"id":&"RETURN_TO_NETWORK_MODE","title":"RETURN TO NETWORK MODE","action_type":&"EXIT_NODE_MODE"},"completion":{"event_type":&"NETWORK_MODE_ENTERED","target_id":&"ACCESS"},"require_fresh_event":true}}],"beat_overrides":{&"FC_UNLOCK_COMMS":{"dialogue":[{"speaker_id":&"LATCH","text":"Run your starter bypass against Legacy Authentication. ACCESS controls the route to COMMS."}],"objective":{"id":&"UNLOCK_ACCESS_COMMS","title":"BYPASS ACCESS CONTROL","action_type":&"BYPASS","target_id":&"ACCESS_AUTH"}},&"FC_REACH_COMMS":{"objective":{"id":&"REACH_COMMS","title":"TRAVERSE THE OPEN ROUTE TO COMMS","action_type":&"MOVE","target_id":&"COMMS"},"require_fresh_event":true}}}
network_nodes = [{"id":&"SAN","display_name":"SAN Entry","node_type":&"GATEWAY","security_level":0,"starting_discovery_state":&"SCANNED","tags":[&"ENTRY"],"services":[&"SAN_HANDSHAKE"]},{"id":&"ACCESS","display_name":"Access","node_type":&"AUTH_SERVER","security_level":0,"starting_discovery_state":&"DETECTED","services":[&"ACCESS_AUTH"],"outbound_path_controls":[{"id":&"OPEN_COMMS","interaction":&"service_disabled","subject_id":&"ACCESS_AUTH","link_ids":[&"ACCESS_COMMS"],"resulting_state":&"UNLOCKED"}]},{"id":&"COMMS","display_name":"Comms","node_type":&"SERVICE_CLUSTER","security_level":1,"starting_discovery_state":&"UNKNOWN","services":[&"OFFICE_FEED"],"outbound_path_controls":[{"id":&"OPEN_SECURITY","interaction":&"stream_intercepted","subject_id":&"OFFICE_FEED","link_ids":[&"COMMS_SECURITY"],"resulting_state":&"UNLOCKED"}]},{"id":&"SECURITY","display_name":"Security","node_type":&"SECURITY_SERVER","security_level":2,"starting_discovery_state":&"UNKNOWN","services":[&"SECURITY_CONSOLE"]},{"id":&"CONTROL","display_name":"Route Control","node_type":&"ACCESS_CONTROL","security_level":1,"starting_discovery_state":&"UNKNOWN","services":[&"ROUTE_CONTROL"],"outbound_path_controls":[{"id":&"REMOTE_DATA_GATE","interaction":&"service_disabled","subject_id":&"ROUTE_CONTROL","link_ids":[&"SECURITY_DATA"],"resulting_state":&"UNLOCKED"}]},{"id":&"DATA","display_name":"Data","node_type":&"FILE_SERVER","security_level":1,"starting_discovery_state":&"UNKNOWN","services":[&"TRAINING_FILE",&"ACCESS_LOG"],"outbound_path_controls":[{"id":&"OPEN_EXIT","interaction":&"file_downloaded","subject_id":&"TRAINING_FILE","link_ids":[&"DATA_EXIT"],"resulting_state":&"UNLOCKED"}]},{"id":&"EXIT","display_name":"Return Route","node_type":&"GATEWAY","security_level":0,"starting_discovery_state":&"UNKNOWN","services":[&"EXIT_HANDSHAKE"]}]
