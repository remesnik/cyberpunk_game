AM_OWNED","definition_id":&"DOORSTOP_TUTORIAL_1_0"},{"type":&"NO_ACTIVE_DOORSTOP_ANCHOR"}],"lines":[{"time":0.0,"speaker_id":&"LATCH","text":"You can burn it here if you want. I'd save it."}],"priority":85,"once":true,"cooldown_actions":3,"tags":[&"MISTAKE",&"DOORSTOP"],"author_notes":"Advice only; deployment remains legal when runtime restrictions permit it."},{"id":&"LATCH_MULTIPLE_DOORSTOPS","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"PROGRAM_INVENTORY_CHANGED","minimum_quantity":2,"conditions":[{"type":&"DEFINITION_COUNT_AT_LEAST","definition_id":&"DOORSTOP_TUTORIAL_1_0","value":2}],"lines":[{"time":0.0,"speaker_id":&"LATCH","text":"Only the one you run gets burned."}],"priority":65,"once":true,"cooldown_actions":3,"tags":[&"FIRST_TIME",&"DOORSTOP"],"author_notes":"Explains physical instance identity without repeating on later inventory changes."},{"id":&"LATCH_NORMAL_JACK_OUT_WARNING","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"NORMAL_JACK_OUT_REQUESTED","conditions":[{"type":&"INTRUSION_ACTIVE"},{"type":&"OBJECTIVE_INCOMPLETE"}],"lines":[{"time":0.0,"speaker_id":&"LATCH","text":"That'll dump the intrusion. Doorstop if you intend to come back."}],"priority":110,"once":true,"cooldown_actions":2,"tags":[&"MISTAKE",&"DANGER"],"author_notes":"Does not block normal Jack Out; it clarifies the consequence before confirmation."},{"id":&"LATCH_DOORSTOP_RETURN","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"DOORSTOP_RETURNED","target_id":&"SEC_RELAY","lines":[{"time":0.0,"speaker_id":&"LATCH","text":"Told you it'd hold."}],"priority":80,"once":true,"cooldown_actions":2,"tags":[&"FIRST_TIME",&"DOORSTOP"],"author_notes":"Short contextual response in addition to the sparse continuity sequence."},{"id":&"LATCH_UNEXPECTED_ENCOUNTER_SOLUTION","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"ENCOUNTER_RESOLVED","allowed_actions":[&"ATTACK_PROCESS",&"REDIRECT",&"SPOOF"],"conditions":[{"type":&"SOLUTION_VALID"},{"type":&"SOLUTION_NOT_RECOMMENDED"}],"lines":[{"time":0.0,"speaker_id":&"LATCH","text":"That works too."}],"priority":75,"once":true,"cooldown_actions":4,"tags":[&"CLEVER",&"ALTERNATE_SOLUTION"],"author_notes":"Reserved for a valid solution outside the highlighted evade/disrupt paths."}]
