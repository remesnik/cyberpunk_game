story_hooks = [{"id":&"LATCH_GREETING","title":"A Familiar Signal","internal_name":&"LATCH_GREETING","summary":"Latch opens the prearranged backchannel when the player enters Meridian.","trigger_conditions":[{"operator":&"ALL","type":&"NODE_ENTERED","reference_id":&"ENTRY"}],"activation_actions":[{"type":&"START_COMMS","target_id":&"LATCH_INGRESS_CALL"}],"completion_conditions":[{"operator":&"ALL","type":&"COMMS_EVENT_HEARD","reference_id":&"LATCH_SUGGESTS_SCAN"}],"failure_conditions":[],"priority":100,"repeat_policy":&"ONCE","expiration":{},"followup_hook_ids":[&"LATCH_SCAN_RELAY"],"tags":[&"LATCH",&"TUTORIAL"],"story_bundle_id":&"FIRST_CONTACT_BUNDLE","author_notes":""},{"id":&"LATCH_SCAN_RELAY","title":"Read the Relay","internal_name":&"LATCH_SCAN_RELAY","summary":"Latch's advice is reflected by authored route discovery on ACCESS_RELAY.","trigger_conditions":[{"operator":&"ALL","type":&"NODE_ENTERED","reference_id":&"ACCESS_RELAY"}],"activation_actions":[{"type":&"SET_OBJECTIVE_HINT","target_id":&"ACCESS_RELAY","value":"Relay diagnostics are emitting route metadata."}],"completion_conditions":[{"operator":&"ALL","type":&"NODE_SCANNED","reference_id":&"ACCESS_RELAY"}],"failure_conditions":[],"priority":90,"repeat_policy":&"ONCE","expiration":{},"followup_hook_ids":[&"LATCH_FIRST_BRANCH"],"tags":[&"LATCH",&"TUTORIAL"],"story_bundle_id":&"FIRST_CONTACT_BUNDLE","author_notes":"Diegetic service observation, not control instruction."},{"id":&"LATCH_FIRST_BRANCH","title":"Two Scent Trails","internal_name":&"LATCH_FIRST_BRANCH","summary":"Latch comments when Router A exposes the first branch.","trigger_conditions":[{"operator":&"ALL","type":&"NODE_SCANNED","reference_id":&"ROUTER_A"}],"activation_actions":[{"type":&"START_COMMS","target_id":&"LATCH_ROUTER_CALL"}],"completion_conditions":[{"operator":&"ANY","type":&"NODE_ENTERED","reference_id":&"CAM_CTL"},{"operator":&"ANY","type":&"NODE_ENTERED","reference_id":&"FILE_CACHE"}],"failure_conditions":[],"priority":80,"repeat_policy":&"ONCE","expiration":{},"followup_hook_ids":[&"LATCH_CAMERA_NOTE",&"LATCH_CACHE_HINT"],"tags":[&"LATCH",&"TUTORIAL"],"story_bundle_id":&"FIRST_CONTACT_BUNDLE","author_notes":""},{"id":&"LATCH_CAMERA_NOTE","title":"Borrowed Eyes","internal_name":&"LATCH_CAMERA_NOTE","summary":"Camera-control traffic reveals the security relay.","trigger_conditions":[{"operator":&"ALL","type":&"SERVICE_SCANNED","reference_id":&"CAMERA_MATRIX"}],"activation_actions":[{"type":&"REVEAL_ENDPOINT","target_id":&"CAM_CTL_ENDPOINT"},{"type":&"REVEAL_NODE","target_id":&"SEC_RELAY"}],"completion_conditions":[{"operator":&"ALL","type":&"ENDPOINT_DISCOVERED","reference_id":&"CAM_CTL_ENDPOINT"}],"failure_conditions":[],"priority":60,"repeat_policy":&"ONCE","expiration":{},"followup_hook_ids":[&"LATCH_SECURITY_WARNING"],"tags":[&"LATCH",&"VIDEO"],"story_bundle_id":&"FIRST_CONTACT_BUNDLE","author_notes":""},{"id":&"LATCH_CACHE_HINT","title":"A Mark in the Cache","internal_name":&"LATCH_CACHE_HINT","summary":"Latch's signed mark points to optional software.","trigger_conditions":[{"operator":&"ALL","type":&"NODE_ENTERED","reference_id":&"FILE_CACHE"}],"activation_actions":[{"type":&"REVEAL_GRAFFITI","target_id":&"LATCH_CACHE_MARK"},{"type":&"REVEAL_OBJECTIVE","target_id":&"RECOVER_LATCH_CACHE"}],"completion_conditions":[{"operator":&"ALL","type":&"REWARD_COLLECTED","reference_id":&"LATCH_UTILITY_REWARD"}],"failure_conditions":[],"priority":50,"repeat_policy":&"ONCE","expiration":{},"followup_hook_ids":[],"tags":[&"LATCH",&"OPTIONAL"],"story_bundle_id":&"FIRST_CONTACT_BUNDLE","author_notes":""},{"id":&"LATCH_SECURITY_WARNING","title":"Hard Pulse","internal_name":&"LATCH_SECURITY_WARNING","summary":"Latch interprets a detected security signal without leaking true ICE state.","trigger_conditions":[{"operator":&"ALL","type":&"NODE_DETECTED","reference_id":&"SEC_RELAY"}],"activation_actions":[{"type":&"START_COMMS","target_id":&"LATCH_SECURITY_CALL"}],"completion_conditions":[{"operator":&"ALL","type":&"SERVICE_COMPROMISED","reference_id":&"SECURITY_TELEMETRY"}],"failure_conditions":[],"priority":70,"repeat_policy":&"ONCE","expiration":{},"followup_hook_ids":[&"LATCH_COMM_NODE"],"tags":[&"LATCH",&"SECURITY"],"story_bundle_id":&"FIRST_CONTACT_BUNDLE","author_notes":"Player knowledge still controls what ICE detail is shown."},{"id":&"LATCH_COMM_NODE","title":"Open Channel","internal_name":&"LATCH_COMM_NODE","summary":"The communications node exposes the route toward operations.","trigger_conditions":[{"operator":&"ALL","type":&"NODE_ENTERED","reference_id":&"COMM_NODE"}],"activation_actions":[{"type":&"REVEAL_ENDPOINT","target_id":&"COMM_NODE_ENDPOINT"}],"completion_conditions":[{"operator":&"ALL","type":&"SERVICE_SCANNED","reference_id":&"INTERNAL_COMMS"}],"failure_conditions":[],"priority":60,"repeat_policy":&"ONCE","expiration":{},"followup_hook_ids":[&"LATCH_OBJECTIVE"],"tags":[&"LATCH",&"COMMS"],"story_bundle_id":&"FIRST_CONTACT_BUNDLE","author_notes":""},{"id":&"LATCH_OBJECTIVE","title":"The Actual Job","internal_name":&"LATCH_OBJECTIVE","summary":"Latch identifies the narrow objective on arrival at Operations.","trigger_conditions":[{"operator":&"ALL","type":&"NODE_ENTERED","reference_id":&"OPS_SERVER"}],"activation_actions":[{"type":&"START_COMMS","target_id":&"LATCH_OBJECTIVE_CALL"},{"type":&"REVEAL_OBJECTIVE","target_id":&"RETRIEVE_ROUTE_MANIFEST"}],"completion_conditions":[{"operator":&"ALL","type":&"OBJECTIVE_COMPLETED","reference_id":&"RETRIEVE_ROUTE_MANIFEST"}],"failure_conditions":[],"priority":90,"repeat_policy":&"ONCE","expiration":{},"followup_hook_ids":[&"LATCH_SIGNOFF"],"tags":[&"LATCH",&"OBJECTIVE"],"story_bundle_id":&"FIRST_CONTACT_BUNDLE","author_notes":""},{"id":&"LATCH_SIGNOFF","title":"Clean Enough","internal_name":&"LATCH_SIGNOFF","summary":"Latch signs off after the player reaches egress with the manifest.","trigger_conditions":[{"operator":&"ALL","type":&"NODE_ENTERED","reference_id":&"EXIT_GATE"},{"operator":&"ALL","type":&"OBJECTIVE_COMPLETED","reference_id":&"RETRIEVE_ROUTE_MANIFEST"}],"activation_actions":[{"type":&"START_COMMS","target_id":&"LATCH_EXIT_CALL"},{"type":&"SET_FLAG","target_id":&"FIRST_CONTACT_COMPLETE","value":true}],"completion_conditions":[{"operator":&"ALL","type":&"COMMS_EVENT_HEARD","reference_id":&"LATCH_TUTORIAL_COMPLETE"}],"failure_conditions":[],"priority":100,"repeat_policy":&"ONCE","expiration":{},"followup_hook_ids":[],"tags":[&"LATCH",&"COMPLETION"],"story_bundle_id":&"FIRST_CONTACT_BUNDLE","author_notes":""}]
story_bundles = [{"id":&"FIRST_CONTACT_BUNDLE","title":"First Contact","summary":"Diegetic first-intrusion guidance delivered by Latch and the network itself.","tags":[&"TUTORIAL",&"LATCH"],"related_nodes":[&"ENTRY",&"ACCESS_RELAY",&"ROUTER_A",&"CAM_CTL",&"FILE_CACHE",&"DIAG_TERMINAL",&"SEC_RELAY",&"COMM_NODE",&"OPS_SERVER",&"EXIT_GATE"],"related_links":[&"ENTRY_ACCESS",&"ACCESS_ROUTER",&"ROUTER_CAMERA",&"ROUTER_CACHE",&"CACHE_DIAG",&"CAM_SECURITY",&"SEC_COMM",&"DIAG_COMM",&"COMM_OPS",&"SEC_OPS",&"OPS_EXIT"],"related_graffiti":[&"LATCH_CACHE_MARK"],"related_flavor":[&"ENTRY_BANNER",&"CAMERA_MOTD",&"COMM_BANNER"],"related_story_hooks":[&"LATCH_GREETING",&"LATCH_SCAN_RELAY",&"LATCH_FIRST_BRANCH",&"LATCH_CAMERA_NOTE",&"LATCH_CACHE_HINT",&"LATCH_SECURITY_WARNING",&"LATCH_COMM_NODE",&"LATCH_OBJECTIVE",&"LATCH_SIGNOFF"],"related_messages":[],"related_comms":[&"LATCH_INGRESS_CALL",&"LATCH_ROUTER_CALL",&"LATCH_SECURITY_CALL",&"LATCH_OBJECTIVE_CALL",&"LATCH_EXIT_CALL"],"related_video_feeds":[],"related_alarms":[],"related_teams":[],"related_meatspace_locations":[],"related_data_assets":[&"OPS_MANIFEST"],"related_realtime_events":[],"author_notes":"Runtime state and tutorial progression are resolved from ordinary authored conditions/actions."}]
story_sequences = [{"id":&"FIRST_CONTACT_OPENING","display_name":"First Contact // Opening","sequence_type":&"DIEGETIC_GUIDANCE","channel_id":&"LATCH_BACKCHANNEL","speaker_actor_id":&"LATCH_REMOTE_ACTOR","blocking":false,"realtime":true,"beats":[{"id":&"FC_ENTRY_ARRIVAL","trigger":{"event_type":&"NODE_ENTERED","target_type":&"NODE","target_id":&"ENTRY"},"delay_seconds":2.0,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"You made it. Good."},{"time":2.0,"speaker_id":&"LATCH","text":"Don't move yet."},{"time":4.5,"speaker_id":&"LATCH","text":"First rule: know what you're standing in before you start poking things."}],"objective":{"id":&"INSPECT_CURRENT_NODE","title":"INSPECT YOUR CURRENT NODE","action_type":&"SCAN","target_id":&"ENTRY"},"commands":[{"type":&"COMMUNICATE","actor_id":&"LATCH_REMOTE_ACTOR","session_id":&"LATCH_INGRESS_CALL"}],"completion":{"event_type":&"NODE_SCANNED","target_id":&"ENTRY"},"author_notes":"The two-second delay lets the ingress settle before Latch calls."},{"id":&"FC_ENTRY_INSPECTED","trigger":{"event_type":&"NODE_SCANNED","target_type":&"NODE","target_id":&"ENTRY"},"delay_seconds":0.6,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"That's the local ingress relay. Nothing interesting, but now you know what's attached to you."},{"time":3.8,"speaker_id":&"LATCH","text":"Connections are movement. Movement costs time."}],"objective":{"id":&"MOVE_TO_ACCESS_RELAY","title":"MOVE TO ACCESS RELAY","action_type":&"MOVE","target_id":&"ACCESS_RELAY"},"commands":[{"type":&"APPEAR","actor_id":&"LATCH_REMOTE_ACTOR","node_id":&"ACCESS_RELAY"},{"type":&"POINT_OUT","actor_id":&"LATCH_REMOTE_ACTOR","target_type":&"NODE","target_id":&"ACCESS_RELAY"}],"completion":{"event_type":&"PLAYER_MOVED","target_id":&"ACCESS_RELAY"},"author_notes":"Latch's process becomes visible on the adjacent relay before the player commits to movement."},{"id":&"FC_ACCESS_RELAY_ENTERED","trigger":{"event_type":&"PLAYER_MOVED","target_type":&"NODE","target_id":&"ACCESS_RELAY"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"And while you're moving, everything else gets a vote."}],"objective":{},"commands":[{"type":&"MOVE","actor_id":&"LATCH_REMOTE_ACTOR","node_id":&"ROUTER_A","delay_seconds":1.5},{"type":&"POINT_OUT","actor_id":&"LATCH_REMOTE_ACTOR","target_type":&"NODE","target_id":&"ROUTER_A","delay_seconds":1.5},{"type":&"STORY_EVENT","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"FIRST_TRAVERSAL_OBSERVED","payload":{"requires_cyber_tick_advance":true}}],"completion":{"event_type":&"NETWORK_TIME_ADVANCED","minimum_units":1},"author_notes":"Player traversal remains a normal MOVE action. Its cost advances the ActionClock, ICE, trace, and network systems before this response resolves."}],"tags":[&"FIRST_CONTACT",&"LATCH",&"OPENING",&"DIEGETIC_TUTORIAL"],"author_notes":"Short realtime lines with action gates between explanations; no modal tutorial presentation."},{"id":&"FIRST_CONTACT_ROUTER_CAMERA","display_name":"First Contact // Router and Camera Control","sequence_type":&"DIEGETIC_GUIDANCE","channel_id":&"LATCH_BACKCHANNEL","speaker_actor_id":&"LATCH_REMOTE_ACTOR","blocking":false,"realtime":true,"beats":[{"id":&"FC_ROUTER_INSPECTION","trigger":{"event_type":&"NODE_ENTERED","target_type":&"NODE","target_id":&"ROUTER_A"},"delay_seconds":0.5,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Router. Read the branches before you pick one."},{"time":3.0,"speaker_id":&"LATCH","text":"Different nodes expose different services. Sometimes hardware, if the wiring is honest."}],"objective":{"id":&"INSPECT_ROUTER_CONNECTIONS","title":"INSPECT CONNECTED SYSTEMS","action_type":&"SCAN","target_id":&"ROUTER_A"},"commands":[],"completion":{"event_type":&"NODE_SCANNED","target_id":&"ROUTER_A"},"author_notes":"Scanning reveals CAM_CTL and FILE_CACHE through ordinary PlayerKnowledge."},{"id":&"FC_CAMERA_ROUTE","trigger":{"event_type":&"NODE_SCANNED","target_type":&"NODE","target_id":&"ROUTER_A"},"delay_seconds":0.5,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Facilities controller on the left branch. Start there."}],"objective":{"id":&"MOVE_TO_CAMERA_CONTROL","title":"ACCESS CAMERA CONTROL","action_type":&"MOVE","target_id":&"CAM_CTL"},"commands":[{"type":&"POINT_OUT","actor_id":&"LATCH_REMOTE_ACTOR","target_type":&"NODE","target_id":&"CAM_CTL"}],"completion":{"event_type":&"PLAYER_MOVED","target_id":&"CAM_CTL"},"author_notes":"Latch recommends a route but never moves the player."},{"id":&"FC_CAMERA_SERVICE_IDENTIFY","trigger":{"event_type":&"NODE_ENTERED","target_type":&"NODE","target_id":&"CAM_CTL"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"There. That's not just a box on the graph."},{"time":2.8,"speaker_id":&"LATCH","text":"Find out what service is talking to the hardware."}],"objective":{"id":&"IDENTIFY_CAMERA_SERVICE","title":"IDENTIFY CAMERA SERVICE","action_type":&"SCAN","target_id":&"CAMERA_MATRIX"},"commands":[],"completion":{"event_type":&"SERVICE_IDENTIFIED","target_id":&"CAMERA_MATRIX"},"author_notes":"Service identity must come from scanning, not UI foreknowledge."},{"id":&"FC_CAMERA_SERVICE_EXAMINE","trigger":{"event_type":&"SERVICE_IDENTIFIED","target_type":&"SERVICE","target_id":&"CAMERA_MATRIX"},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Camera Matrix. Check its state before you run anything against it."}],"objective":{"id":&"EXAMINE_CAMERA_STATE","title":"EXAMINE CAMERA MATRIX STATE","action_type":&"SCAN","target_id":&"CAMERA_MATRIX","required_knowledge":&"SCANNED"},"commands":[],"completion":{"event_type":&"SERVICE_SCANNED","target_id":&"CAMERA_MATRIX"},"author_notes":"Identification and state inspection are separate knowledge thresholds."},{"id":&"FC_CAMERA_COMPROMISE","trigger":{"event_type":&"SERVICE_SCANNED","target_type":&"SERVICE","target_id":&"CAMERA_MATRIX"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Default service token. Your probe is compatible. Put it to work."}],"objective":{"id":&"COMPROMISE_CAMERA_MATRIX","title":"RUN SERVICE PROBE","action_type":&"EXPLOIT","target_id":&"CAMERA_MATRIX","compatible_program_ids":[&"SERVICE_PROBE"]},"commands":[],"completion":{"event_type":&"SERVICE_COMPROMISED","target_id":&"CAMERA_MATRIX"},"author_notes":"Uses the generic exploit/program path and its normal cyber action cost."},{"id":&"FC_CAMERA_CONTROLS","trigger":{"event_type":&"SERVICE_COMPROMISED","target_type":&"SERVICE","target_id":&"CAMERA_MATRIX"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Those cameras are real."},{"time":2.3,"speaker_id":&"LATCH","text":"Select one. You can watch it, turn it, or make it go quiet for a while."}],"objective":{"id":&"OPEN_CAMERA_FEED","title":"VIEW A CAMERA FEED","action_type":&"MONITOR","target_id":&"CAM_LOBBY_01"},"commands":[{"type":&"REVEAL_ENDPOINT","target_id":&"CAM_CTL_ENDPOINT"},{"type":&"REVEAL_PROCESS","target_id":&"CAM_LOBBY_01"}],"completion":{"event_type":&"VIDEO_OBSERVED","target_id":&"CAM_LOBBY_01"},"author_notes":"Compromise exposes meat-space controls through PlayerKnowledge; it does not directly open UI."},{"id":&"FC_CAMERA_DISABLE","trigger":{"event_type":&"VIDEO_OBSERVED","target_type":&"VIDEO","target_id":&"CAM_LOBBY_01"},"delay_seconds":0.5,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Turn one off and some guard downstairs gets a much quieter evening."}],"objective":{"id":&"DISABLE_CAMERA_FEED","title":"TEMPORARILY DISABLE CAMERA 01","action_type":&"DISABLE","target_id":&"CAM_LOBBY_01"},"commands":[],"completion":{"event_type":&"VIDEO_STATE_CHANGED","target_id":&"CAM_LOBBY_01","state":&"OFFLINE"},"author_notes":"Progress requires a logical video-feed DISABLE action; hiding or closing the monitor does not count."},{"id":&"FC_CAMERA_COMPLETE","trigger":{"event_type":&"VIDEO_STATE_CHANGED","target_type":&"VIDEO","target_id":&"CAM_LOBBY_01","state":&"OFFLINE"},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"That's control. A graph action, a physical consequence."}],"objective":{},"commands":[{"type":&"STORY_EVENT","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"CAMERA_TUTORIAL_COMPLETE","payload":{"feed_id":&"CAM_LOBBY_01"}}],"completion":{"event_type":&"CAMERA_TUTORIAL_COMPLETE"},"author_notes":"Feed restoration remains available through the normal video system."}],"tags":[&"FIRST_CONTACT",&"LATCH",&"CAMERA_TUTORIAL",&"DIEGETIC_TUTORIAL"],"author_notes":"Each mechanic is separated by a player action; realtime comms remain non-modal."},{"id":&"FIRST_CONTACT_TRACE_AND_ICE","display_name":"First Contact // Trace and ICE","sequence_type":&"DIEGETIC_GUIDANCE","channel_id":&"LATCH_BACKCHANNEL","speaker_actor_id":&"LATCH_REMOTE_ACTOR","blocking":false,"realtime":true,"beats":[{"id":&"FC_CAMERA_TRACE","trigger":{"event_type":&"VIDEO_STATE_CHANGED","target_type":&"VIDEO","target_id":&"CAM_LOBBY_01","state":&"OFFLINE"},"delay_seconds":0.2,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"That's trace."},{"time":2.0,"speaker_id":&"LATCH","text":"The network knows something happened. It doesn't know who yet."}],"objective":{"id":&"OBSERVE_TRACE","title":"OBSERVE TRACE RESPONSE","observation_type":&"TRACE_UPDATED","minimum_increase":2},"commands":[{"type":&"ACTIVATE_ICE","target_id":&"SEC_RELAY_AUDITOR_01"},{"type":&"DETECT_ICE","target_id":&"SEC_RELAY_AUDITOR_01"}],"completion":{"event_type":&"TRACE_UPDATED","minimum_increase":2},"author_notes":"CAM_LOBBY_01 DISABLE contributes two trace through the video action's normal trace_generated path. This is visible and remains far below failure threshold."},{"id":&"FC_ICE_DETECTED","trigger":{"event_type":&"ICE_DETECTED","target_type":&"ICE","target_id":&"SEC_RELAY_AUDITOR_01"},"delay_seconds":0.5,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"See the red process?"},{"time":1.8,"speaker_id":&"LATCH","text":"That's ICE."},{"time":3.5,"speaker_id":&"LATCH","text":"It's not angry yet."}],"objective":{"id":&"IDENTIFY_PASSIVE_ICE","title":"IDENTIFY THE SECURITY PROCESS","action_type":&"SCAN","target_id":&"SEC_RELAY_AUDITOR_01","required_knowledge":&"IDENTIFIED"},"commands":[{"type":&"POINT_OUT","actor_id":&"LATCH_REMOTE_ACTOR","target_type":&"ICE","target_id":&"SEC_RELAY_AUDITOR_01"}],"completion":{"event_type":&"ICE_IDENTIFIED","target_id":&"SEC_RELAY_AUDITOR_01"},"author_notes":"Latch reveals only a signal. PlayerKnowledge controls identity and true position details."},{"id":&"FC_ICE_INSPECT","trigger":{"event_type":&"ICE_IDENTIFIED","target_type":&"ICE","target_id":&"SEC_RELAY_AUDITOR_01"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Identify tells you what it is. Inspect tells you what it can notice."}],"objective":{"id":&"INSPECT_PASSIVE_ICE","title":"INSPECT ICE STATE","action_type":&"SCAN","target_id":&"SEC_RELAY_AUDITOR_01","required_knowledge":&"SCANNED"},"commands":[],"completion":{"event_type":&"ICE_SCANNED","target_id":&"SEC_RELAY_AUDITOR_01"},"author_notes":"The scan result exposes PATROL, detection radius zero, scan capability one, and movement cost three."},{"id":&"FC_TRACE_DECISION","trigger":{"event_type":&"ICE_SCANNED","target_type":&"ICE","target_id":&"SEC_RELAY_AUDITOR_01"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Every move, scan, or program gives trace and security another chance to change the board."},{"time":3.0,"speaker_id":&"LATCH","text":"You can move, gather more information, or wait and watch. Just choose on purpose."}],"objective":{"id":&"ACT_UNDER_TRACE","title":"CHOOSE YOUR NEXT ACTION","allowed_action_types":[&"MOVE",&"SCAN",&"WAIT"],"requires_trace_above":0},"commands":[],"completion":{"event_type":&"PLAYER_ACTION_RESOLVED","allowed_action_types":[&"MOVE",&"SCAN",&"WAIT"]},"author_notes":"No modal pause. The actual ActionClock advances ICE, trace, and network systems in their normal deterministic order."}],"tags":[&"FIRST_CONTACT",&"LATCH",&"TRACE_TUTORIAL",&"ICE_TUTORIAL"],"author_notes":"Low-threat pressure immediately follows camera manipulation; no fake trace meter or tutorial-only enemy AI."},{"id":&"FIRST_CONTACT_LIVE_COMMS","display_name":"First Contact // Live Communications","sequence_type":&"DIEGETIC_GUIDANCE","channel_id":&"LATCH_BACKCHANNEL","speaker_actor_id":&"LATCH_REMOTE_ACTOR","blocking":false,"realtime":true,"beats":[{"id":&"FC_COMM_NODE_DISCOVERY","trigger":{"event_type":&"NODE_ENTERED","target_type":&"NODE","target_id":&"COMM_NODE"},"delay_seconds":0.5,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Comms node. Something live is riding the facilities channel."}],"objective":{"id":&"DISCOVER_LIVE_CALL","title":"INSPECT INTERNAL COMMS","action_type":&"SCAN","target_id":&"INTERNAL_COMMS"},"commands":[],"completion":{"event_type":&"REALTIME_ENDPOINT_DISCOVERED","target_id":&"COMM_NODE_ENDPOINT"},"author_notes":"Scanning commits endpoint/process knowledge; the call may already be partway through its realtime duration."},{"id":&"FC_LIVE_CALL_AVAILABLE","trigger":{"event_type":&"REALTIME_ENDPOINT_DISCOVERED","target_type":&"ENDPOINT","target_id":&"COMM_NODE_ENDPOINT"},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"That's a live call."}],"objective":{"id":&"CHOOSE_CALL_ACCESS","title":"LIVE CALL AVAILABLE","choices":[{"id":&"MONITOR_CALL","label":"MONITOR","operation":&"MONITOR","target_id":&"GUARD_CAMERA_FAULT_CALL"},{"id":&"INTERCEPT_CALL","label":"INTERCEPT","operation":&"INTERCEPT","target_id":&"GUARD_CAMERA_FAULT_CALL"},{"id":&"IGNORE_CALL","label":"IGNORE","operation":&"IGNORE","target_id":&"GUARD_CAMERA_FAULT_CALL"}],"optional":true},"commands":[{"type":&"REVEAL_PROCESS","target_id":&"GUARD_CAMERA_CALL_PROCESS"}],"completion":{"event_type":&"PLAYER_COMMS_CHOICE","target_id":&"GUARD_CAMERA_FAULT_CALL"},"author_notes":"Ignoring remains valid and does not stop the underlying process."},{"id":&"FC_CALL_INTERCEPTED","trigger":{"event_type":&"COMMS_INTERCEPTED","target_type":&"COMMS","target_id":&"GUARD_CAMERA_FAULT_CALL"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Once you've tapped it, the clock out there doesn't care about our little turn system."}],"objective":{"id":&"LISTEN_OR_CONTINUE","title":"LISTEN OR CONTINUE THE INTRUSION","choices":[{"id":&"LISTEN","operation":&"LISTEN","target_id":&"GUARD_CAMERA_FAULT_CALL"},{"id":&"CONTINUE","operation":&"IGNORE","target_id":&"GUARD_CAMERA_FAULT_CALL"}],"optional":true},"commands":[],"completion":{"event_type":&"PLAYER_ACTION_RESOLVED"},"author_notes":"COMMS monitor is non-modal; transcript playback and cyberspace input remain active together."},{"id":&"FC_CALL_INTELLIGENCE","trigger":{"event_type":&"HEARD_COMMS_EVENT","target_type":&"COMMS_EVENT","target_id":&"GUARD_CHECKING_RELAY"},"delay_seconds":0.2,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Useful. Their problem is happening in meat space, in real time. Our route choices still spend cyber ticks."}],"objective":{},"commands":[{"type":&"STORY_EVENT","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"GUARD_RELAY_INTEL_ACQUIRED","payload":{"source_session_id":&"GUARD_CAMERA_FAULT_CALL"}}],"completion":{"event_type":&"GUARD_RELAY_INTEL_ACQUIRED"},"author_notes":"This beat occurs only if the relevant live line is actually heard."},{"id":&"FC_CALL_MANIPULATION_OPTION","trigger":{"event_type":&"COMMS_ACCESS_EVALUATED","target_type":&"COMMS","target_id":&"GUARD_CAMERA_FAULT_CALL"},"delay_seconds":0.0,"dialogue":[],"objective":{"id":&"OPTIONAL_CALL_INJECTION","title":"OPTIONAL: MANIPULATE CALL","action_type":&"INJECT","target_id":&"GUARD_CAMERA_FAULT_CALL","optional":true,"show_requirements":true},"commands":[],"completion":{"event_type":&"COMMS_INJECTED","target_id":&"GUARD_CAMERA_FAULT_CALL"},"author_notes":"Shown only when the generic CommsAccessResult says injection is available; otherwise requirements are explained and the player can ignore it."}],"tags":[&"FIRST_CONTACT",&"LATCH",&"COMMS_TUTORIAL",&"DUAL_TIME"],"author_notes":"The call is an objective RealtimeProcess. Cyber ticks cannot advance, pause, restart, or flush its timeline."},{"id":&"FIRST_CONTACT_SOFTWARE_CACHE","display_name":"First Contact // Software Cache","sequence_type":&"DIEGETIC_GUIDANCE","channel_id":&"LATCH_BACKCHANNEL","speaker_actor_id":&"LATCH_REMOTE_ACTOR","blocking":false,"realtime":true,"beats":[{"id":&"FC_FILE_CACHE_ENTERED","trigger":{"event_type":&"NODE_ENTERED","target_type":&"NODE","target_id":&"FILE_CACHE"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Someone left the deployment index open. Have a look."}],"objective":{"id":&"INSPECT_FILE_CACHE","title":"INSPECT SOFTWARE CACHE","action_type":&"SCAN","target_id":&"CACHE_INDEX"},"commands":[],"completion":{"event_type":&"HIDDEN_CACHE_DISCOVERED","target_id":&"FILE_CACHE_SOFTWARE_BUNDLE"},"author_notes":"Discovery is an ordinary node/service scan and PlayerKnowledge update."},{"id":&"FC_DOORSTOP_DISCOVERED","trigger":{"event_type":&"HIDDEN_CACHE_DISCOVERED","target_type":&"HIDDEN_CACHE","target_id":&"FILE_CACHE_SOFTWARE_BUNDLE"},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Oh, nice."},{"time":1.5,"speaker_id":&"LATCH","text":"Doorstop."},{"time":3.2,"speaker_id":&"LATCH","text":"If this gets messy, that little thing is how you go home without throwing the whole intrusion away."}],"objective":{"id":&"INSPECT_SOFTWARE_CACHE","title":"INSPECT CACHE CONTENTS","action_type":&"INSPECT","target_id":&"FILE_CACHE_SOFTWARE_BUNDLE","items":[{"reward_id":&"LATCH_UTILITY_REWARD","quantity":1},{"reward_id":&"TUTORIAL_DOORSTOP_REWARD","quantity":1,"inspection_text":"DOORSTOP\nDisposable backdoor utility.\n\nCreates a temporary return route from the current cyberspace node.\n\nOne use."}]},"commands":[],"completion":{"event_type":&"CACHE_INSPECTED","target_id":&"FILE_CACHE_SOFTWARE_BUNDLE"},"author_notes":"Inspection is contextual content, not a detached tutorial popup."},{"id":&"FC_CACHE_COLLECTION","trigger":{"event_type":&"CACHE_INSPECTED","target_type":&"HIDDEN_CACHE","target_id":&"FILE_CACHE_SOFTWARE_BUNDLE"},"delay_seconds":0.2,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Take both. Doorstop is disposable, so don't confuse owning one with having a permanent way out."}],"objective":{"id":&"COLLECT_CACHE_PROGRAMS","title":"TAKE SOFTWARE","action_type":&"COLLECT","target_id":&"FILE_CACHE_SOFTWARE_BUNDLE"},"commands":[],"completion":{"event_type":&"REWARDS_COLLECTED","target_id":&"FILE_CACHE_SOFTWARE_BUNDLE","required_reward_ids":[&"LATCH_UTILITY_REWARD",&"TUTORIAL_DOORSTOP_REWARD"]},"author_notes":"Generic reward production creates one Route Sniffer instance and one unique Doorstop instance."},{"id":&"FC_DOORSTOP_PLACEMENT_CONTEXT","trigger":{"event_type":&"REWARDS_COLLECTED","target_type":&"HIDDEN_CACHE","target_id":&"FILE_CACHE_SOFTWARE_BUNDLE"},"delay_seconds":0.5,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"You can deploy it from a valid node. You don't need to do that here."},{"time":2.8,"speaker_id":&"LATCH","text":"The return route anchors where you burn it. Placement matters."}],"objective":{"id":&"CONTINUE_BEFORE_DOORSTOP","title":"CONTINUE THE INTRUSION","allowed_action_types":[&"MOVE"],"forbidden_action_types":[],"minimum_additional_nodes":1,"doorstop_deployment_required":false},"commands":[],"completion":{"event_type":&"PLAYER_MOVED","origin_id":&"FILE_CACHE","minimum_distinct_nodes_after_reward":1},"author_notes":"The tutorial explicitly permits deployment but neither requests nor blocks it. Progress requires visiting at least one additional node so placement has context."},{"id":&"FC_AFTER_CACHE_MOVE","trigger":{"event_type":&"PLAYER_MOVED","origin_id":&"FILE_CACHE"},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Now you have a choice: anchor here later, or carry it deeper and risk more getting there."}],"objective":{},"commands":[{"type":&"STORY_EVENT","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"DOORSTOP_PLACEMENT_LESSON_COMPLETE","payload":{"deployment_was_forced":false}}],"completion":{"event_type":&"DOORSTOP_PLACEMENT_LESSON_COMPLETE"},"author_notes":"No automatic deployment and no Doorstop consumption."}],"tags":[&"FIRST_CONTACT",&"LATCH",&"SOFTWARE_CACHE",&"DOORSTOP_TUTORIAL"],"author_notes":"Guaranteed rewards use the generic program reward pipeline; Doorstop remains optional."},{"id":&"FIRST_CONTACT_SEC_RELAY_DOORSTOP","display_name":"First Contact // Secure a Return Route","sequence_type":&"DIEGETIC_GUIDANCE","channel_id":&"LATCH_BACKCHANNEL","speaker_actor_id":&"LATCH_REMOTE_ACTOR","blocking":false,"realtime":true,"beats":[{"id":&"FC_SEC_RELAY_PRESSURE","trigger":{"operator":&"ALL","conditions":[{"event_type":&"NODE_ENTERED","target_type":&"NODE","target_id":&"SEC_RELAY"},{"type":&"TRACE_AT_LEAST","value":4},{"type":&"PROGRAM_OWNED","definition_id":&"DOORSTOP_TUTORIAL_1_0","minimum_quantity":1},{"type":&"REWARD_COLLECTED","reference_id":&"TUTORIAL_DOORSTOP_REWARD"},{"type":&"STORY_EVENT_OCCURRED","reference_id":&"CAMERA_TUTORIAL_COMPLETE"},{"type":&"MEANINGFUL_PROGRESS_AT_LEAST","value":3}]},"delay_seconds":0.5,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"We've got what we need from this side."},{"time":2.0,"speaker_id":&"LATCH","text":"That auditor is starting to lean our way."},{"time":4.0,"speaker_id":&"LATCH","text":"Drop that Doorstop."},{"time":6.0,"speaker_id":&"LATCH","text":"Then you can get out, change your kit, and come right back here."}],"objective":{"id":&"DEPLOY_DOORSTOP_SEC_RELAY","title":"DEPLOY DOORSTOP AT SEC RELAY","action_type":&"USE_PROGRAM","system":&"DOORSTOP","required_program_definition_id":&"DOORSTOP_TUTORIAL_1_0","target_node_id":&"SEC_RELAY","consume_specific_instance":true},"commands":[{"type":&"SET_ICE_STATE","target_id":&"SEC_RELAY_AUDITOR_01","state":&"INVESTIGATE","target_node_id":&"SEC_RELAY","minimum_alert_level":25}],"completion":{"event_type":&"DOORSTOP_DEPLOYED","node_id":&"SEC_RELAY"},"author_notes":"This invokes the actual Doorstop program action. The exact selected instance burns and a DoorstopAnchor is created; no checkpoint state is authored."},{"id":&"FC_SEC_RELAY_ANCHORED","trigger":{"event_type":&"DOORSTOP_DEPLOYED","target_type":&"NODE","target_id":&"SEC_RELAY"},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Good."},{"time":1.6,"speaker_id":&"LATCH","text":"That route is yours once."},{"time":3.5,"speaker_id":&"LATCH","text":"Jack out."}],"objective":{"id":&"JACK_OUT_THROUGH_DOORSTOP","title":"JACK OUT THROUGH DOORSTOP","action_type":&"JACK_OUT_DOORSTOP","requires_active_anchor":true,"target_node_id":&"SEC_RELAY"},"commands":[],"completion":{"event_type":&"INTRUSION_LIFECYCLE_CHANGED","state":&"SUSPENDED_AT_DOORSTOP"},"author_notes":"Normal abort/end-intrusion does not satisfy this objective. The real anchor remains active while suspended."}],"tags":[&"FIRST_CONTACT",&"LATCH",&"DOORSTOP_TUTORIAL",&"SEC_RELAY"],"author_notes":"Pressure recommends the one-shot backdoor only after the player has context for placement."},{"id":&"FIRST_CONTACT_MEATSPACE_MANAGEMENT","display_name":"First Contact // Suspended Intrusion Management","sequence_type":&"DIEGETIC_GUIDANCE","channel_id":&"LATCH_BACKCHANNEL","speaker_actor_id":&"LATCH_REMOTE_ACTOR","blocking":false,"realtime":true,"domain":&"MEATSPACE","beats":[{"id":&"FC_MEATSPACE_ARRIVAL","trigger":{"operator":&"ALL","conditions":[{"event_type":&"INTRUSION_LIFECYCLE_CHANGED","state":&"SUSPENDED_AT_DOORSTOP"},{"type":&"ACTIVE_DOORSTOP_ANCHOR","node_id":&"SEC_RELAY"}]},"delay_seconds":0.5,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"You're out."},{"time":1.8,"speaker_id":&"LATCH","text":"The backdoor's still sitting where you left it."},{"time":4.0,"speaker_id":&"LATCH","text":"Do whatever you're going to do. Just remember: when you go back, you're going back into the same mess."}],"objective":{"id":&"INSPECT_DECK_MEATSPACE","title":"INSPECT YOUR DECK","action_type":&"INSPECT_DECK","domain":&"MEATSPACE"},"commands":[{"type":&"COMMUNICATE","actor_id":&"LATCH_REMOTE_ACTOR","session_id":&"LATCH_MEATSPACE_MANAGEMENT"}],"completion":{"event_type":&"DECK_INSPECTED"},"author_notes":"Latch's backchannel is realtime and remains available outside cyberspace."},{"id":&"FC_DECK_INSPECTED","trigger":{"event_type":&"DECK_INSPECTED"},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"The Doorstop copy is gone. The route isn't. Different things."}],"objective":{"id":&"CHANGE_ONE_PROGRAM","title":"CHANGE ONE LOADED PROGRAM","allowed_action_types":[&"INSTALL_PROGRAM",&"REMOVE_PROGRAM"],"minimum_changes":1,"domain":&"MEATSPACE"},"commands":[],"completion":{"event_type":&"LOADOUT_CHANGED","minimum_changes":1},"author_notes":"Uses ProgramInventory and ProgramLoadout instance IDs. The burned Doorstop cannot reappear."},{"id":&"FC_LOADOUT_CHANGED","trigger":{"event_type":&"LOADOUT_CHANGED","minimum_changes":1},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Better. Put the spare cycles to work while we're here."}],"objective":{"id":&"START_SOFTWARE_TASK","title":"PROGRAM A SOFTWARE UTILITY","action_type":&"START_PROGRAMMING","allowed_definition_ids":[&"DOORSTOP_TUTORIAL_1_0",&"ROUTE_SNIFFER_0_8"],"suggested_definition_id":&"DOORSTOP_TUTORIAL_1_0","domain":&"MEATSPACE"},"commands":[],"completion":{"event_type":&"SOFTWARE_PROGRAMMING_STARTED"},"author_notes":"Programming uses RealtimeWorldClock and the generic production queue, never CyberspaceClock."},{"id":&"FC_PROGRAMMING_STARTED","trigger":{"event_type":&"SOFTWARE_PROGRAMMING_STARTED"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Trace didn't vanish. Neither did the alarm, or that auditor."},{"time":2.8,"speaker_id":&"LATCH","text":"Jack back in and the temporary route closes behind you."}],"objective":{"id":&"RETURN_THROUGH_DOORSTOP","title":"JACK BACK IN","action_type":&"JACK_BACK_IN_DOORSTOP","requires_suspended_intrusion":true,"requires_active_anchor":true,"return_node_id":&"SEC_RELAY","destroy_anchor_on_success":true,"domain":&"MEATSPACE","enabled":true},"commands":[],"completion":{"event_type":&"INTRUSION_LIFECYCLE_CHANGED","state":&"ACTIVE"},"author_notes":"Enabled only after the three management lessons. Re-entry applies the current loadout and consumes the one-use anchor."}],"persistent_state_callouts":[{"id":&"TRACE_PERSISTS","label":"TRACE PRESERVED","source":&"INTRUSION_RESUME_STATE"},{"id":&"ALARMS_PERSIST","label":"ALARMS REMAIN ACTIVE","source":&"INTRUSION_RESUME_STATE"},{"id":&"ICE_PERSISTS","label":"ICE STATE PRESERVED","source":&"INTRUSION_RESUME_STATE"},{"id":&"DOORSTOP_CONSUMED","label":"DOORSTOP INSTANCE CONSUMED","source":&"PROGRAM_INVENTORY"},{"id":&"ANCHOR_ONE_USE","label":"RETURN DESTROYS ANCHOR","source":&"DOORSTOP_ANCHOR"}],"tags":[&"FIRST_CONTACT",&"LATCH",&"MEATSPACE_TUTORIAL",&"DOORSTOP_TUTORIAL"],"author_notes":"Management actions occur in realtime meat space and cannot advance cyber movement or ticks."},{"id":&"FIRST_CONTACT_REENTRY_ENCOUNTER","display_name":"First Contact // Re-entry Continuity","sequence_type":&"DIEGETIC_GUIDANCE","channel_id":&"LATCH_BACKCHANNEL","speaker_actor_id":&"LATCH_REMOTE_ACTOR","blocking":false,"realtime":true,"domain":&"CYBERSPACE","beats":[{"id":&"FC_REENTRY_CONTINUITY","trigger":{"operator":&"ALL","conditions":[{"event_type":&"INTRUSION_LIFECYCLE_CHANGED","state":&"ACTIVE"},{"type":&"RETURNED_THROUGH_DOORSTOP","node_id":&"SEC_RELAY"},{"type":&"DOORSTOP_ANCHOR_DESTROYED"},{"type":&"LOADOUT_APPLIED"}]},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Welcome back."},{"time":1.8,"speaker_id":&"LATCH","text":"Notice anything?"},{"time":3.8,"speaker_id":&"LATCH","text":"The network didn't forget you."}],"objective":{"id":&"OBSERVE_PERSISTENT_INTRUSION","title":"ASSESS THE NETWORK","observation_fields":[&"TRACE",&"ALARM_STATE",&"ICE_STATE",&"CURRENT_LOADOUT"],"expected_node_id":&"SEC_RELAY"},"commands":[],"completion":{"event_type":&"PERSISTENT_STATE_PRESENTED"},"author_notes":"Presentation reads the resumed intrusion. It does not restore or reconstruct tutorial state."},{"id":&"FC_AUDITOR_ACTIVE","trigger":{"event_type":&"PERSISTENT_STATE_PRESENTED"},"delay_seconds":2.0,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Auditor's committed now. Don't freeze—pick a route or interfere with it."}],"objective":{"id":&"HANDLE_FIRST_ICE_ENCOUNTER","title":"RESPOND TO THE AUDITOR","choices":[{"id":&"EVADE_TO_CAMERA","label":"EVADE VIA CAMERA CONTROL","action_type":&"RETREAT","target_id":&"CAM_CTL","requirements":[]},{"id":&"DISRUPT_AUDITOR","label":"DISRUPT ICE","action_type":&"DISRUPT","target_id":&"SEC_RELAY_AUDITOR_01","requirements":[]},{"id":&"ATTACK_AUDITOR","label":"DISABLE ICE PROCESS","action_type":&"ATTACK_PROCESS","target_id":&"SEC_RELAY_AUDITOR_01","requirements":[]},{"id":&"REDIRECT_AUDITOR","label":"REDIRECT ICE","action_type":&"REDIRECT","target_id":&"SEC_RELAY_AUDITOR_01","redirect_node_id":&"COMM_NODE","requirements":[&"SPOOF"]}]},"commands":[{"type":&"SET_ICE_STATE","target_id":&"SEC_RELAY_AUDITOR_01","state":&"HUNT","target_node_id":&"SEC_RELAY","minimum_alert_level":40}],"completion":{"operator":&"ANY","events":[&"PLAYER_RETREATED",&"ICE_DISRUPTED",&"ICE_INTEGRITY_DAMAGED",&"ICE_REDIRECTED",&"IDENTITY_SPOOFED"]},"author_notes":"All choices resolve through ConfrontationController and ActionClock. Unsupported capabilities hide only their associated option."},{"id":&"FC_FIRST_ENCOUNTER_RESOLVED","trigger":{"operator":&"ANY","events":[&"PLAYER_RETREATED",&"ICE_DISRUPTED",&"ICE_INTEGRITY_DAMAGED",&"ICE_REDIRECTED",&"IDENTITY_SPOOFED"]},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Good. Topology, timing, programs—use whichever keeps you moving."}],"objective":{},"commands":[{"type":&"STORY_EVENT","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"FIRST_ICE_ENCOUNTER_COMPLETE"}],"completion":{"event_type":&"FIRST_ICE_ENCOUNTER_COMPLETE"},"author_notes":"No single required solution."}],"forgiveness":{"ice_movement_cost":3,"ice_defense":0,"ice_initial_integrity":6,"minimum_actions_before_contact":1,"forced_failure":false},"tags":[&"FIRST_CONTACT",&"LATCH",&"REENTRY",&"ICE_ENCOUNTER"],"author_notes":"The persisted low-threat auditor becomes active shortly after exact-node re-entry."},{"id":&"FIRST_CONTACT_FINAL_OBJECTIVE","display_name":"First Contact // Operations Objective and Exit","sequence_type":&"MISSION_FINALE","channel_id":&"LATCH_BACKCHANNEL","speaker_actor_id":&"LATCH_REMOTE_ACTOR","blocking":false,"realtime":true,"domain":&"CYBERSPACE","beats":[{"id":&"FC_OPS_ARRIVAL","trigger":{"event_type":&"NODE_ENTERED","target_type":&"NODE","target_id":&"OPS_SERVER"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Operations. Last job: the service route manifest."},{"time":2.5,"speaker_id":&"LATCH","text":"Same process as before. Read the host and the security around it."}],"objective":{"id":&"INSPECT_OPS_SERVER","title":"INSPECT OPERATIONS SERVER","action_type":&"SCAN","target_id":&"OPS_SERVER"},"commands":[],"completion":{"operator":&"ALL","conditions":[{"event_type":&"NODE_SCANNED","target_id":&"OPS_SERVER"},{"type":&"LOCAL_SECURITY_ASSESSED","minimum_ice_knowledge":&"IDENTIFIED"}]},"author_notes":"Combines navigation, node inspection, and existing ICE knowledge without introducing a new system."},{"id":&"FC_OPS_SERVICE","trigger":{"event_type":&"NODE_SCANNED","target_type":&"NODE","target_id":&"OPS_SERVER"},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Legacy export on the manifest service. Use the kit you brought back in."}],"objective":{"id":&"COMPROMISE_OPS_MANIFEST","title":"COMPROMISE MANIFEST SERVICE","action_type":&"EXPLOIT","target_id":&"OPS_MANIFEST","required_knowledge":&"SCANNED","compatible_program_ids":[&"SERVICE_PROBE",&"ROUTE_SNIFFER_0_8"],"requires_installed_program":true,"trace_guidance":{"warn_at":12,"failure_at":20,"allowed_responses":[&"TRACE_SCRAMBLE",&"WAIT",&"RETREAT"]}},"commands":[],"completion":{"event_type":&"SERVICE_COMPROMISED","target_id":&"OPS_MANIFEST"},"author_notes":"Uses existing service exploitation, loadout, action cost, and trace systems."},{"id":&"FC_OPS_EXTRACT","trigger":{"event_type":&"SERVICE_COMPROMISED","target_type":&"SERVICE","target_id":&"OPS_MANIFEST"},"delay_seconds":0.3,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Service is open. Take the manifest—nothing else."}],"objective":{"id":&"RETRIEVE_ROUTE_MANIFEST","title":"RETRIEVE SERVICE ROUTE MANIFEST","action_type":&"TRANSFER","target_id":&"OPS_MANIFEST","resource_id":&"SERVICE_ROUTE_MANIFEST","quantity":1},"commands":[],"completion":{"event_type":&"OBJECTIVE_COMPLETED","target_id":&"RETRIEVE_ROUTE_MANIFEST"},"author_notes":"Completion uses the existing authored primary objective and opens OPS_EXIT."},{"id":&"FC_OBJECTIVE_COMPLETE","trigger":{"event_type":&"OBJECTIVE_COMPLETED","target_type":&"OBJECTIVE","target_id":&"RETRIEVE_ROUTE_MANIFEST"},"delay_seconds":0.4,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"Got it."},{"time":1.5,"speaker_id":&"LATCH","text":"Now leave."},{"time":3.2,"speaker_id":&"LATCH","text":"And no, we don't need another Doorstop."}],"objective":{"id":&"EXIT_FIRST_CONTACT_NORMALLY","title":"EXIT THROUGH MAINTENANCE EGRESS","action_type":&"MOVE","target_id":&"EXIT_GATE","completion_mode":&"NORMAL_EXIT","doorstop_jack_out_allowed":true,"doorstop_jack_out_completes_mission":false},"commands":[{"type":&"UNLOCK_LINK","target_id":&"OPS_EXIT"}],"completion":{"event_type":&"NODE_ENTERED","target_id":&"EXIT_GATE"},"author_notes":"Doorstop suspension remains available as a safety choice but never counts as mission completion."},{"id":&"FC_NORMAL_EXIT","trigger":{"event_type":&"NODE_ENTERED","target_type":&"NODE","target_id":&"EXIT_GATE"},"delay_seconds":0.2,"dialogue":[{"time":0.0,"speaker_id":&"LATCH","text":"That's an exit. Job finished, connection closed, nothing left hanging."}],"objective":{},"commands":[{"type":&"COMPLETE_INTRUSION","mode":&"NORMAL","level_id":&"FIRST_CONTACT","required_objective_id":&"RETRIEVE_ROUTE_MANIFEST","exit_node_id":&"EXIT_GATE"},{"type":&"SET_FLAG","target_id":&"FIRST_CONTACT_COMPLETE","value":true}],"completion":{"operator":&"ALL","conditions":[{"event_type":&"INTRUSION_LIFECYCLE_CHANGED","state":&"COMPLETED"},{"type":&"FLAG_SET","reference_id":&"FIRST_CONTACT_COMPLETE"}]},"author_notes":"Normal completion changes lifecycle to COMPLETED. It cannot be resumed and creates no DoorstopAnchor."}],"learned_skill_summary":[&"GRAPH_NAVIGATION",&"NODE_INSPECTION",&"ICE_ASSESSMENT",&"INSTALLED_PROGRAM_USE",&"TRACE_MANAGEMENT",&"TARGET_INTERACTION",&"NORMAL_EXIT"],"tags":[&"FIRST_CONTACT",&"LATCH",&"FINAL_OBJECTIVE",&"NORMAL_EXIT"],"author_notes":"Final synthesis only; no major new mechanic."}]
