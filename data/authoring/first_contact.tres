[gd_resource type="Resource" script_class="CyberspaceContentDocument" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/authoring/CyberspaceContentDocument.gd" id="1"]

[resource]
script = ExtResource("1")
document_id = &"FIRST_CONTACT"
title = "First Contact"
summary = "A first guided intrusion into a small Meridian service subnet. Latch is present on-network and teaches through diegetic realtime comms."
tags = Array[StringName]([&"INTRODUCTION", &"TUTORIAL", &"DIEGETIC", &"CORPORATE_SUBNET"])
tutorial_guidance_rules = [{"id":&"FC_HINT_ACCESS_RELAY","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"TUTORIAL_STALLED","objective_id":&"INSPECT_ACCESS_RELAY","hints":["Take another look at the relay.","You're looking for the service attached to the east connection.","CAM_CTL. Scan it."],"respond_after":1,"recoverable":true,"hard_fail":false,"recovery_policy":&"KEEP_OBJECTIVE_ACTIVE","priority":50},{"id":&"FC_WRONG_PROGRAM","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"PROGRAM_ACTION_REJECTED","hints":["Wrong shape for that service. Read what it accepts, then pick again."],"once":true,"recoverable":true,"hard_fail":false,"recovery_policy":&"REFUND_INVALID_ACTION_IF_RULES_ALLOW","priority":70},{"id":&"FC_WRONG_ROUTE","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"PLAYER_LEFT_GUIDED_ROUTE","hints":["That's not the route I meant. It may still be useful—look around, or head back when you're done."],"once":true,"recoverable":true,"hard_fail":false,"recovery_policy":&"ALLOW_EXPLORATION","priority":40},{"id":&"FC_LATCH_IGNORED","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"TUTORIAL_STALLED","objective_id":&"ACKNOWLEDGE_LATCH_GUIDANCE","hints":["Still with me? Check the objective when you're ready.","No rush from me. Security may feel differently."],"respond_after":2,"recoverable":true,"hard_fail":false,"recovery_policy":&"KEEP_OBJECTIVE_ACTIVE","priority":30},{"id":&"FC_TRACE_CRITICAL","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"TRACE_UPDATED","minimum_trace":16,"hints":["Trace is hot. Back off, scramble it, or finish fast."],"once":true,"recoverable":true,"hard_fail":false,"recovery_policy":&"USE_NORMAL_TRACE_RESPONSES","priority":100},{"id":&"FC_ICE_DETECTION","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"PLAYER_DETECTED_BY_ICE","hints":["It found you. That's pressure, not a death sentence. Break contact or interfere with it."],"once":true,"recoverable":true,"hard_fail":false,"recovery_policy":&"CONTINUE_ENCOUNTER","priority":110},{"id":&"FC_DOORSTOP_ELSEWHERE","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"DOORSTOP_DEPLOYED_OUTSIDE_SUGGESTED_NODE","hints":["Not where I'd have put it, but it holds. If you leave, that's where you're coming back."],"once":true,"recoverable":true,"hard_fail":false,"recovery_policy":&"ADOPT_ACTUAL_ANCHOR_NODE","priority":90},{"id":&"FC_UNEXPECTED_LOADOUT","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"TUTORIAL_LOADOUT_CHANGED","hints":["Not my pick, but it's your deck. Make sure the new program gives you a way forward."],"once":true,"recoverable":true,"hard_fail":false,"recovery_policy":&"ACCEPT_ANY_VALID_LOADOUT_CHANGE","priority":60},{"id":&"FC_MISSED_OPTIONAL_COMMS","actor_id":&"LATCH_REMOTE_ACTOR","event_type":&"OPTIONAL_COMMS_MISSED","hints":["Call's gone. Happens. The network still has other ways to tell you what's moving."],"once":true,"recoverable":true,"hard_fail":false,"recovery_policy":&"CONTINUE_WITH_ALTERNATE_INTEL","priority":55}]
network_nodes = [{"id":&"ENTRY","display_name":"Public Service Entry","node_type":&"GATEWAY","owner":&"MERIDIAN_SERVICES","faction":&"CORPORATE","security_level":0,"description":"A customer-facing session terminator with a thin route into the service subnet.","tags":[&"ENTRY",&"ANCHOR",&"TUTORIAL_START"],"region_id":&"PERIMETER","services":[&"ENTRY_HANDSHAKE"],"starting_discovery_state":&"SCANNED","graffiti":[],"flavor_text":[&"ENTRY_BANNER"],"story_hooks":[&"LATCH_GREETING"],"author_notes":"Only ACCESS_RELAY is visible initially."},{"id":&"ACCESS_RELAY","display_name":"Access Relay","node_type":&"SERVICE_CLUSTER","owner":&"MERIDIAN_SERVICES","faction":&"CORPORATE","security_level":0,"description":"A low-risk relay that exposes the difference between occupying and scanning a node.","tags":[&"RELAY",&"TUTORIAL_SCAN"],"region_id":&"PERIMETER","services":[&"RELAY_DIAGNOSTICS"],"starting_discovery_state":&"IDENTIFIED","graffiti":[],"flavor_text":[],"story_hooks":[&"LATCH_SCAN_RELAY"],"author_notes":"Scanning reveals ROUTER_A."},{"id":&"ROUTER_A","display_name":"Router A","node_type":&"ROUTER","owner":&"MERIDIAN_SERVICES","faction":&"CORPORATE","security_level":1,"description":"The subnet's first meaningful route decision.","tags":[&"ROUTER",&"TUTORIAL_ROUTE_CHOICE"],"region_id":&"OPERATIONS_EDGE","services":[&"ROUTE_TABLE"],"starting_discovery_state":&"UNKNOWN","graffiti":[],"flavor_text":[],"story_hooks":[&"LATCH_FIRST_BRANCH"],"author_notes":"Opens the camera and cache branches."},{"id":&"CAM_CTL","display_name":"Camera Control","node_type":&"CAMERA_SERVER","owner":&"MERIDIAN_FACILITIES","faction":&"CORPORATE","security_level":1,"description":"A modest camera-control service with observable security traffic.","tags":[&"CAMERA",&"TUTORIAL_ENDPOINT"],"region_id":&"FACILITIES","services":[&"CAMERA_MATRIX"],"starting_discovery_state":&"UNKNOWN","graffiti":[],"flavor_text":[&"CAMERA_MOTD"],"story_hooks":[&"LATCH_CAMERA_NOTE"],"author_notes":"Introduces service scanning and a meatspace endpoint without making it mandatory."},{"id":&"FILE_CACHE","display_name":"File Cache","node_type":&"FILE_SERVER","owner":&"MERIDIAN_SERVICES","faction":&"CORPORATE","security_level":1,"description":"A neglected deployment cache containing a useful disposable utility.","tags":[&"CACHE",&"OPTIONAL",&"TUTORIAL_REWARD"],"region_id":&"OPERATIONS_EDGE","services":[&"CACHE_INDEX"],"starting_discovery_state":&"UNKNOWN","graffiti":[&"LATCH_CACHE_MARK"],"flavor_text":[],"story_hooks":[&"LATCH_CACHE_HINT"],"author_notes":"Optional reward teaches that exploration can improve the loadout."},{"id":&"DIAG_TERMINAL","display_name":"Diagnostic Terminal","node_type":&"WORKSTATION","owner":&"MERIDIAN_SUPPORT","faction":&"CORPORATE","security_level":1,"description":"A support terminal carelessly trusted by the communications node.","tags":[&"OPTIONAL",&"DIAGNOSTICS"],"region_id":&"OPERATIONS_EDGE","services":[&"SUPPORT_SHELL"],"starting_discovery_state":&"UNKNOWN","graffiti":[],"flavor_text":[],"story_hooks":[],"author_notes":"Small side node and alternate approach to COMM_NODE."},{"id":&"SEC_RELAY","display_name":"Security Relay","node_type":&"SECURITY_SERVER","owner":&"MERIDIAN_SECURITY","faction":&"SECURITY","security_level":2,"description":"A watched relay carrying ICE telemetry and access decisions.","tags":[&"SECURITY",&"TUTORIAL_ICE",&"TUTORIAL_TRACE"],"region_id":&"SECURITY","services":[&"SECURITY_TELEMETRY"],"starting_discovery_state":&"UNKNOWN","graffiti":[],"flavor_text":[],"story_hooks":[&"LATCH_SECURITY_WARNING"],"author_notes":"First controlled security pressure; do not spawn lethal ICE."},{"id":&"COMM_NODE","display_name":"Communications Node","node_type":&"SERVICE_CLUSTER","owner":&"MERIDIAN_SERVICES","faction":&"CORPORATE","security_level":1,"description":"Internal messaging and voice-session routing.","tags":[&"COMMS",&"TUTORIAL_INTERCEPT"],"region_id":&"OPERATIONS","services":[&"INTERNAL_COMMS"],"starting_discovery_state":&"UNKNOWN","graffiti":[],"flavor_text":[&"COMM_BANNER"],"story_hooks":[&"LATCH_COMM_NODE"],"author_notes":"Establishes that realtime communications continue while cyber decisions are made."},{"id":&"OPS_SERVER","display_name":"Operations Server","node_type":&"SYSTEM","owner":&"MERIDIAN_SERVICES","faction":&"CORPORATE","security_level":2,"description":"The objective host: retrieve the sanitized service-route manifest.","tags":[&"OBJECTIVE",&"TUTORIAL_EXPLOIT",&"TUTORIAL_TRANSFER"],"region_id":&"OPERATIONS","services":[&"OPS_MANIFEST"],"starting_discovery_state":&"UNKNOWN","graffiti":[],"flavor_text":[],"story_hooks":[&"LATCH_OBJECTIVE"],"author_notes":"Successful hack opens EXIT_GATE route."},{"id":&"EXIT_GATE","display_name":"Maintenance Egress","node_type":&"GATEWAY","owner":&"MERIDIAN_SERVICES","faction":&"CORPORATE","security_level":1,"description":"A maintenance route back out of the subnet.","tags":[&"EXIT",&"TUTORIAL_COMPLETE"],"region_id":&"PERIMETER","services":[&"EGRESS_HANDSHAKE"],"starting_discovery_state":&"UNKNOWN","graffiti":[],"flavor_text":[],"story_hooks":[&"LATCH_SIGNOFF"],"author_notes":"Only opens after objective completion."}]
network_links = [{"id":&"ENTRY_ACCESS","source":&"ENTRY","destination":&"ACCESS_RELAY","one_way":false,"hidden":false,"locked":false,"disabled":false,"traversal_cost":1,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[],"unlock_conditions":[],"tags":[&"INITIAL_ROUTE"],"story_hooks":[],"author_notes":"The only initial movement choice."},{"id":&"ACCESS_ROUTER","source":&"ACCESS_RELAY","destination":&"ROUTER_A","one_way":false,"hidden":false,"locked":false,"disabled":false,"traversal_cost":1,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[{"type":&"NODE_SCANNED","reference_id":&"ACCESS_RELAY"}],"unlock_conditions":[],"tags":[&"REVEALED_BY_SCAN"],"story_hooks":[],"author_notes":"Scanning the relay reveals this route."},{"id":&"ROUTER_CAMERA","source":&"ROUTER_A","destination":&"CAM_CTL","one_way":false,"hidden":false,"locked":false,"disabled":false,"traversal_cost":1,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[{"type":&"NODE_SCANNED","reference_id":&"ROUTER_A"}],"unlock_conditions":[],"tags":[&"BRANCH"],"story_hooks":[],"author_notes":"Visible after Router A is inspected."},{"id":&"ROUTER_CACHE","source":&"ROUTER_A","destination":&"FILE_CACHE","one_way":false,"hidden":false,"locked":false,"disabled":false,"traversal_cost":1,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[{"type":&"NODE_SCANNED","reference_id":&"ROUTER_A"}],"unlock_conditions":[],"tags":[&"BRANCH",&"OPTIONAL"],"story_hooks":[],"author_notes":"Optional reward branch."},{"id":&"CACHE_DIAG","source":&"FILE_CACHE","destination":&"DIAG_TERMINAL","one_way":false,"hidden":true,"locked":false,"disabled":false,"traversal_cost":1,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[{"type":&"SERVICE_SCANNED","reference_id":&"CACHE_INDEX"}],"unlock_conditions":[],"tags":[&"HIDDEN_ROUTE",&"OPTIONAL"],"story_hooks":[],"author_notes":"A small discoverable alternate route."},{"id":&"CAM_SECURITY","source":&"CAM_CTL","destination":&"SEC_RELAY","one_way":false,"hidden":false,"locked":false,"disabled":false,"traversal_cost":1,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[{"type":&"SERVICE_SCANNED","reference_id":&"CAMERA_MATRIX"}],"unlock_conditions":[],"tags":[&"SECURITY_APPROACH"],"story_hooks":[],"author_notes":"Camera traffic points toward security relay."},{"id":&"SEC_COMM","source":&"SEC_RELAY","destination":&"COMM_NODE","one_way":false,"hidden":false,"locked":true,"disabled":false,"traversal_cost":1,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[],"unlock_conditions":[{"type":&"SERVICE_COMPROMISED","reference_id":&"SECURITY_TELEMETRY"}],"tags":[&"TUTORIAL_LOCK"],"story_hooks":[],"author_notes":"A logical trust rule, not a colored lock."},{"id":&"DIAG_COMM","source":&"DIAG_TERMINAL","destination":&"COMM_NODE","one_way":false,"hidden":false,"locked":false,"disabled":false,"traversal_cost":2,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[{"type":&"NODE_DISCOVERED","reference_id":&"DIAG_TERMINAL"}],"unlock_conditions":[],"tags":[&"ALTERNATE_ROUTE"],"story_hooks":[],"author_notes":"Longer but avoids the security-relay lock."},{"id":&"COMM_OPS","source":&"COMM_NODE","destination":&"OPS_SERVER","one_way":false,"hidden":false,"locked":false,"disabled":false,"traversal_cost":1,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[{"type":&"SERVICE_SCANNED","reference_id":&"INTERNAL_COMMS"}],"unlock_conditions":[],"tags":[&"OBJECTIVE_ROUTE"],"story_hooks":[],"author_notes":"Comms metadata reveals the objective host."},{"id":&"SEC_OPS","source":&"SEC_RELAY","destination":&"OPS_SERVER","one_way":true,"hidden":true,"locked":false,"disabled":false,"traversal_cost":2,"authority_requirement":1,"capability_requirement":&"","discovery_conditions":[{"type":&"SERVICE_COMPROMISED","reference_id":&"SECURITY_TELEMETRY"}],"unlock_conditions":[],"tags":[&"RISKY_SHORTCUT"],"story_hooks":[],"author_notes":"Optional high-risk shortcut."},{"id":&"OPS_EXIT","source":&"OPS_SERVER","destination":&"EXIT_GATE","one_way":true,"hidden":false,"locked":true,"disabled":false,"traversal_cost":1,"authority_requirement":0,"capability_requirement":&"","discovery_conditions":[{"type":&"NODE_DISCOVERED","reference_id":&"OPS_SERVER"}],"unlock_conditions":[{"type":&"OBJECTIVE_COMPLETED","reference_id":&"RETRIEVE_ROUTE_MANIFEST"}],"tags":[&"EXIT_ROUTE"],"story_hooks":[],"author_notes":"Opened by completing the objective."}]
