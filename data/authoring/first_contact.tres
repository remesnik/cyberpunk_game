flavor_text = [{"id":&"ENTRY_BANNER","category":&"SYSTEM_BANNER","text":"MERIDIAN SERVICE FABRIC // AUTHORIZED SESSIONS LOGGED","speaker_or_source":&"ENTRY","target_type":&"NetworkNode","target_id":&"ENTRY","conditions":[],"priority":1,"weight":1.0,"once_only":false,"cooldown_actions":0,"tags":[&"CORPORATE"],"author_notes":""},{"id":&"CAMERA_MOTD","category":&"SYSTEM_BANNER","text":"FACILITIES OPTICS // 6 STREAMS // 1 DEGRADED","speaker_or_source":&"CAM_CTL","target_type":&"NetworkNode","target_id":&"CAM_CTL","conditions":[],"priority":1,"weight":1.0,"once_only":false,"cooldown_actions":0,"tags":[&"VIDEO"],"author_notes":""},{"id":&"COMM_BANNER","category":&"SYSTEM_BANNER","text":"INTERNAL COMMS // SESSION METADATA RETAINED 30 DAYS","speaker_or_source":&"COMM_NODE","target_type":&"NetworkNode","target_id":&"COMM_NODE","conditions":[],"priority":1,"weight":1.0,"once_only":false,"cooldown_actions":0,"tags":[&"COMMS"],"author_notes":""}]
comms_participants = [{"id":&"LATCH","display_name":"Latch","callsign":"LATCH","faction":&"INDEPENDENT","description":"An experienced hacker already ghosting through the Meridian subnet."},{"id":&"PLAYER_PROCESS","display_name":"Unknown Process","callsign":"YOU","faction":&"PLAYER"},{"id":&"LOBBY_GUARD","display_name":"Lobby Security Guard","callsign":"GUARD","faction":&"MERIDIAN_SECURITY"},{"id":&"FACILITIES_TECH","display_name":"Facilities Technician","callsign":"FACILITIES","faction":&"MERIDIAN_SERVICES"}]
comms_channels = [{"id":&"LATCH_BACKCHANNEL","display_name":"Latch Backchannel","comms_type":&"PRIVATE_RADIO_CHANNEL","participants":[&"LATCH",&"PLAYER_PROCESS"],"story_tags":[&"LATCH",&"DIEGETIC_TUTORIAL"],"author_notes":"A fictional encrypted in-network voice/text channel."},{"id":&"FACILITIES_FAULT_CHANNEL","display_name":"Facilities Fault Call","comms_type":&"PHONE_CALL","participants":[&"LOBBY_GUARD",&"FACILITIES_TECH"],"source_endpoint_id":&"COMM_NODE_ENDPOINT","monitor_policy":{"authority":0,"trace_cost":0,"detection_enabled":false},"intercept_policy":{"authority":0,"capability":&"","program":&"COMMS_TAP","trace_cost":1,"detection_enabled":false},"record_policy":{"authority":0,"trace_cost":0,"detection_enabled":false},"inject_policy":{"authority":1,"capability":&"SPOOF","program":&"VOICE_INJECTOR","trace_cost":3,"detection_enabled":true,"detection_risk":0.35},"story_tags":[&"FIRST_CONTACT",&"CAMERA_FAULT"],"author_notes":"Monitoring, interception, recording, and injection remain separate access operations."}]
hacker_npcs = [{"id":&"LATCH_REMOTE_ACTOR","definition_id":&"LATCH","display_name":"Latch","callsign":"LATCH","faction":&"INDEPENDENT","relationship":&"ALLY","description":"An experienced hacker independently traversing the Meridian subnet.","initial_node_id":&"ACCESS_RELAY","initial_state":&"HIDDEN","comms_channel_id":&"LATCH_BACKCHANNEL","visual_signature":&"REMOTE_PROCESS","local_visibility_hops":1,"player_commandable":false,"movement_driver":&"STORY_SCRIPT","story_tags":[&"LATCH",&"TUTORIAL"],"scripted_reactions":[],"author_notes":"Latch is neither party member nor ICE. StoryHooks issue APPEAR, MOVE, DISAPPEAR, COMMUNICATE, POINT_OUT, and STORY_EVENT commands."}]
comms_sessions = [{"id":&"LATCH_INGRESS_CALL","display_name":"Latch // Ingress","channel_id":&"LATCH_BACKCHANNEL","participants":[&"LATCH",&"PLAYER_PROCESS"],"start_conditions":[{"operator":&"ALL","type":&"NODE_ENTERED","reference_id":&"ENTRY"}],"duration":18.0,"encryption_level":0,"monitor_requirement":{},"intercept_requirement":{},"record_requirement":{},"inject_requirement":{},"timeline":[{"time":0.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"There you are. Meridian calls this edge public. It isn't friendly, just bored.","story_event_id":&"LATCH_CONTACT_ESTABLISHED"},{"time":5.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"I can see one clean relay from your process. Move when you're ready; every hop gives security time to breathe.","story_event_id":&"LATCH_EXPLAINS_MOVEMENT"},{"time":12.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Once you're on it, read the relay before choosing where to go. Networks tell on themselves.","story_event_id":&"LATCH_SUGGESTS_SCAN"}],"story_tags":[&"LATCH",&"INTRO"],"author_notes":"Guidance names in-world consequences, never keyboard controls."},{"id":&"LATCH_ROUTER_CALL","display_name":"Latch // First Branch","channel_id":&"LATCH_BACKCHANNEL","participants":[&"LATCH",&"PLAYER_PROCESS"],"start_conditions":[{"operator":&"ALL","type":&"NODE_SCANNED","reference_id":&"ROUTER_A"}],"duration":17.0,"encryption_level":0,"monitor_requirement":{},"intercept_requirement":{},"record_requirement":{},"inject_requirement":{},"timeline":[{"time":0.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Good. Two useful scents: facilities traffic and a sloppy file cache.","story_event_id":&"LATCH_IDENTIFIES_BRANCHES"},{"time":6.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Neither is the objective. One teaches you the building; the other may pay for the detour.","story_event_id":&"LATCH_EXPLAINS_OPTIONAL_ROUTE"},{"time":12.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Pick with the trace in mind. Retreat is a decision, not a failure.","story_event_id":&"LATCH_EXPLAINS_RETREAT"}],"story_tags":[&"LATCH",&"ROUTING"],"author_notes":""},{"id":&"LATCH_SECURITY_CALL","display_name":"Latch // Security Relay","channel_id":&"LATCH_BACKCHANNEL","participants":[&"LATCH",&"PLAYER_PROCESS"],"start_conditions":[{"operator":&"ALL","type":&"NODE_DETECTED","reference_id":&"SEC_RELAY"}],"duration":19.0,"encryption_level":0,"monitor_requirement":{},"intercept_requirement":{},"record_requirement":{},"inject_requirement":{},"timeline":[{"time":0.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"That hard pulse is ICE telemetry. You don't know the process yet, only that something is watching the route.","story_event_id":&"LATCH_EXPLAINS_PARTIAL_ICE_KNOWLEDGE"},{"time":7.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Scan buys information and spends time. Moving blind spends less time and buys risk.","story_event_id":&"LATCH_EXPLAINS_ACTION_ECONOMY"},{"time":14.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"The comms trust is locked behind that relay. Break the trust, or find who it already trusts.","story_event_id":&"LATCH_EXPLAINS_LOGICAL_GATE"}],"story_tags":[&"LATCH",&"SECURITY"],"author_notes":""},{"id":&"LATCH_OBJECTIVE_CALL","display_name":"Latch // Operations","channel_id":&"LATCH_BACKCHANNEL","participants":[&"LATCH",&"PLAYER_PROCESS"],"start_conditions":[{"operator":&"ALL","type":&"NODE_ENTERED","reference_id":&"OPS_SERVER"}],"duration":16.0,"encryption_level":0,"monitor_requirement":{},"intercept_requirement":{},"record_requirement":{},"inject_requirement":{},"timeline":[{"time":0.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Operations. The route manifest is the job—not the whole server.","story_event_id":&"LATCH_IDENTIFIES_OBJECTIVE"},{"time":6.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Inspect the service, exploit what you actually found, then pull the manifest.","story_event_id":&"LATCH_EXPLAINS_EXPLOIT_TRANSFER"},{"time":12.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Extraction opens maintenance egress. Leave with the data; don't linger for applause.","story_event_id":&"LATCH_EXPLAINS_EXIT"}],"story_tags":[&"LATCH",&"OBJECTIVE"],"author_notes":""},{"id":&"LATCH_EXIT_CALL","display_name":"Latch // Signoff","channel_id":&"LATCH_BACKCHANNEL","participants":[&"LATCH",&"PLAYER_PROCESS"],"start_conditions":[{"operator":&"ALL","type":&"NODE_ENTERED","reference_id":&"EXIT_GATE"},{"operator":&"ALL","type":&"OBJECTIVE_COMPLETED","reference_id":&"RETRIEVE_ROUTE_MANIFEST"}],"duration":10.0,"encryption_level":0,"monitor_requirement":{},"intercept_requirement":{},"record_requirement":{},"inject_requirement":{},"timeline":[{"time":0.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Clean enough. You chose a route, learned what mattered, and left before the net chose for you.","story_event_id":&"LATCH_TUTORIAL_COMPLETE"},{"time":6.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"Keep the channel. Next subnet won't be this polite.","story_event_id":&"LATCH_CHANNEL_RETAINED"}],"story_tags":[&"LATCH",&"COMPLETION"],"author_notes":""},{"id":&"GUARD_CAMERA_FAULT_CALL","display_name":"Camera Fault Call","channel_id":&"FACILITIES_FAULT_CHANNEL","realtime_process_id":&"GUARD_CAMERA_CALL_PROCESS","participants":[&"LOBBY_GUARD",&"FACILITIES_TECH"],"start_conditions":[{"operator":&"ALL","type":&"VIDEO_STATE_CHANGED","reference_id":&"CAM_LOBBY_01","value":&"OFFLINE"}],"duration":45.0,"encryption_level":0,"monitor_requirement":{},"intercept_requirement":{},"record_requirement":{},"inject_requirement":{"authority":1,"capability":&"SPOOF","program":&"VOICE_INJECTOR"},"timeline":[{"time":0.0,"type":&"TRANSCRIPT","speaker_id":&"LOBBY_GUARD","text":"Facilities, lobby camera one just dropped.","story_event_id":&"CAMERA_FAULT_REPORTED"},{"time":6.0,"type":&"TRANSCRIPT","speaker_id":&"FACILITIES_TECH","text":"Controller still answers. Could be the feed process.","story_event_id":&"CONTROLLER_STILL_ONLINE"},{"time":14.0,"type":&"TRANSCRIPT","speaker_id":&"LOBBY_GUARD","text":"I'll finish the lobby sweep, then check the relay closet.","story_event_id":&"GUARD_CHECKING_RELAY"},{"time":28.0,"type":&"TRANSCRIPT","speaker_id":&"FACILITIES_TECH","text":"Copy. Logging it as intermittent until you confirm.","story_event_id":&"FAULT_LOGGED"}],"story_tags":[&"FIRST_CONTACT",&"CAMERA_FAULT",&"LIVE_MEATSPACE"],"author_notes":"Timeline uses process-relative realtime. Discovery and listening never restart it."},{"id":&"LATCH_MEATSPACE_MANAGEMENT","display_name":"Latch // Meat-space Management","channel_id":&"LATCH_BACKCHANNEL","participants":[&"LATCH",&"PLAYER_PROCESS"],"start_conditions":[{"operator":&"ALL","type":&"INTRUSION_LIFECYCLE_EQUALS","value":&"SUSPENDED_AT_DOORSTOP"}],"duration":18.0,"encryption_level":0,"monitor_requirement":{},"intercept_requirement":{},"record_requirement":{},"inject_requirement":{},"timeline":[{"time":0.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"You're out.","story_event_id":&"LATCH_MEATSPACE_CONTACT"},{"time":2.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"The backdoor's still sitting where you left it.","story_event_id":&"LATCH_ANCHOR_CONFIRMED"},{"time":6.0,"type":&"TRANSCRIPT","speaker_id":&"LATCH","text":"When you go back, you're going back into the same mess.","story_event_id":&"LATCH_STATE_PERSISTS"}],"story_tags":[&"LATCH",&"MEATSPACE_TUTORIAL"],"author_notes":"Realtime backchannel remains non-modal while the player manages persistent systems."}]
