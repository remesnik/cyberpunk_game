[gd_resource type="Resource" script_class="MeatspacePrologueDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/story/MeatspacePrologueDefinition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"STORY_PROLOGUE"
display_name = "BEDROOM // LOCAL DECK BAY"
opening_text = "Late evening. Cheap blinds cut the city glow into narrow bands. Your deck is open on the desk, its case held together by old screws and newer intentions."
initial_phase = &"CLAN_SELECTION"
room_objects = [{"id":&"DESK","display_name":"DESK","kind":&"DESK","interaction_text":"[ EXAMINE ]","description":"A sturdy secondhand desk. Cable marks and solder burns map years of late nights."},{"id":&"BED","display_name":"BED","kind":&"BED","rect":Vector4(0.05,0.16,0.28,0.42),"interaction_text":"[ SLEEP ]","description":"A narrow bed under a plain blanket. It has done its job often enough."},{"id":&"POSTER_VIRUS","display_name":"VIRUS POSTER","kind":&"POSTER","rect":Vector4(0.08,0.03,0.16,0.09),"interaction_text":"[ EXAMINE ]","description":"A severe geometric print advertising an old underground software release."},{"id":&"POSTER_PHREAKER","display_name":"PHREAKER POSTER","kind":&"POSTER","rect":Vector4(0.27,0.03,0.16,0.09),"interaction_text":"[ EXAMINE ]","description":"Switching diagrams and hand-drawn frequency notes reproduced in cheap ink."},{"id":&"POSTER_WAREZ","display_name":"WAREZ POSTER","kind":&"POSTER","rect":Vector4(0.46,0.03,0.16,0.09),"interaction_text":"[ EXAMINE ]","description":"An archived release-group emblem. The date is older than the paper."},{"id":&"STARTER_DECK_BOX","display_name":"CARDBOARD SHIPPING BOX","kind":&"BOX","visual_state":{&"open":&"DECK_SELECTED"},"rect":Vector4(0.61,0.19,0.13,0.11),"interaction_text":"[ OPEN ]","description":"Shipping labels removed. Three deck configurations are packed inside.","phase_interactions":{&"DECK_SELECTION":&"DECK_CRATE"}},{"id":&"TOOLBOX","display_name":"CLOSED TOOLBOX","kind":&"TOOLBOX","visual_state":{&"open":&"TOOLBOX_USED"},"rect":Vector4(0.77,0.2,0.13,0.09),"interaction_text":"[ OPEN TOOLBOX ]","description":"A scratched steel toolbox beside the delivery box.","phase_interactions":{&"TOOLBOX":&"TOOLBOX"}},{"id":&"DISPLAY_TABLE","display_name":"DISPLAY / WORK TABLE","kind":&"TABLE","visual_state":{&"equipped":&"DECK_SELECTED"},"rect":Vector4(0.52,0.42,0.37,0.18),"interaction_text":"[ INSPECT ]","description":"An empty work surface waiting for hardware, evidence, or unfinished projects."},{"id":&"BOOKSHELF","display_name":"BOOKSHELF","kind":&"SHELF","rect":Vector4(0.06,0.68,0.27,0.19),"interaction_text":"[ BROWSE ]","description":"Manuals, photocopied zines, repair notes, and a few unrelated paperbacks."},{"id":&"JACK_IN_INTERFACE","display_name":"COMPUTER / DECK JACK","kind":&"JACK","rect":Vector4(0.61,0.68,0.29,0.2),"interaction_text":"[ JACK IN ]","description":"Deck cradle, isolation switch, terminal, and a coiled interface lead.","phase_interactions":{&"CLAN_SELECTION":&"CLAN_TERMINAL",&"READY_TO_JACK_IN":&"DECK_CHAIR",&"BBS_OFFLINE":&"BBS_DIALER",&"BBS_CONNECTED":&"BBS_HELP_DESK"}}]
interactions = [{"id":&"CLAN_TERMINAL","phase":&"CLAN_SELECTION","display_name":"COMMUNITY BOARD","description":"Choose the crowd whose methods shaped your first tools.","prompt":"WHO TAUGHT YOU TO THINK ABOUT NETWORKS?","choices":[{"id":&"CLAN_GHOSTS","label":"GHOSTS","description":"Quiet reconnaissance and careful exits.","result_text":"You keep the Ghosts' rule close: information first, noise later.","actions":[{"type":&"SET_PLAYER_FIELD","id":&"clan_id","value":&"GHOSTS"},{"type":&"SET_FLAG","id":&"CLAN_SELECTED"},{"type":&"SET_PHASE","value":&"DECK_SELECTION"}]},{"id":&"CLAN_OPERATORS","label":"OPERATORS","description":"Practical intrusion and system control.","result_text":"Operators taught you that a working route beats a beautiful theory.","actions":[{"type":&"SET_PLAYER_FIELD","id":&"clan_id","value":&"OPERATORS"},{"type":&"SET_FLAG","id":&"CLAN_SELECTED"},{"type":&"SET_PHASE","value":&"DECK_SELECTION"}]},{"id":&"CLAN_CRASHERS","label":"CRASHERS","description":"Direct pressure and aggressive programs.","result_text":"Crashers call subtlety a resource. You know when to spend it.","actions":[{"type":&"SET_PLAYER_FIELD","id":&"clan_id","value":&"CRASHERS"},{"type":&"SET_FLAG","id":&"CLAN_SELECTED"},{"type":&"SET_PHASE","value":&"DECK_SELECTION"}]}]},{"id":&"DECK_CRATE","phase":&"DECK_SELECTION","display_name":"OPEN DECK CASE","description":"Three familiar configurations. Same battered chassis; different compromises.","prompt":"SELECT STARTER DECK CONFIGURATION","required_flags":[&"CLAN_SELECTED"],"choices":[{"id":&"DECK_SCOUT","label":"SCOUT CONFIGURATION","description":"More memory and Route Sniffer loaded.","result_text":"The memory test passes. Mostly.","actions":[{"type":&"SET_PLAYER_FIELD","id":&"deck_id","value":&"STARTER_SCOUT"},{"type":&"SET_HARDWARE","value":{&"DECK_CPU":1,&"DECK_RAM":2,&"DECK_STORAGE":1}},{"type":&"SET_LOADOUT","value":[&"STARTER_ROUTE_SNIFFER_001"]},{"type":&"SET_FLAG","id":&"DECK_SELECTED"},{"type":&"SET_PHASE","value":&"TOOLBOX"}]},{"id":&"DECK_BALANCED","label":"BALANCED CONFIGURATION","description":"Service Probe loaded with even hardware allocation.","result_text":"Conservative. Reliable. Nothing wrong with that.","actions":[{"type":&"SET_PLAYER_FIELD","id":&"deck_id","value":&"STARTER_BALANCED"},{"type":&"SET_HARDWARE","value":{&"DECK_CPU":1,&"DECK_RAM":1,&"DECK_STORAGE":1}},{"type":&"SET_LOADOUT","value":[&"STARTER_SERVICE_PROBE_001"]},{"type":&"SET_FLAG","id":&"DECK_SELECTED"},{"type":&"SET_PHASE","value":&"TOOLBOX"}]},{"id":&"DECK_HOTROD","label":"HOTROD CONFIGURATION","description":"Extra compute, less room for mistakes.","result_text":"The processor whine settles into a tolerable pitch.","actions":[{"type":&"SET_PLAYER_FIELD","id":&"deck_id","value":&"STARTER_HOTROD"},{"type":&"SET_HARDWARE","value":{&"DECK_CPU":2,&"DECK_RAM":1,&"DECK_STORAGE":1}},{"type":&"SET_LOADOUT","value":[&"STARTER_SERVICE_PROBE_001"]},{"type":&"SET_FLAG","id":&"DECK_SELECTED"},{"type":&"SET_PHASE","value":&"TOOLBOX"}]}]},{"id":&"TOOLBOX","phase":&"TOOLBOX","display_name":"TOOLBOX","description":"A soldering iron, spare memory, and exactly enough confidence to make things worse.","prompt":"OPTIONAL DECK MODIFICATION","required_flags":[&"DECK_SELECTED"],"choices":[{"id":&"ADD_MEMORY","label":"FIT SPARE MEMORY","description":"Spend 75 credits. Increase deck RAM by one.","result_text":"The replacement module survives its smoke test.","actions":[{"type":&"SPEND_CREDITS","amount":75},{"type":&"MODIFY_HARDWARE","id":&"DECK_RAM","amount":1},{"type":&"SET_FLAG","id":&"TOOLBOX_USED"},{"type":&"SET_PHASE","value":&"READY_TO_JACK_IN"}]},{"id":&"SKIP_TOOLBOX","label":"CLOSE THE CASE","description":"Keep the configuration as selected.","result_text":"You decide not to fix what currently boots.","actions":[{"type":&"SET_PHASE","value":&"READY_TO_JACK_IN"}]}]},{"id":&"DECK_CHAIR","phase":&"READY_TO_JACK_IN","display_name":"DECK INTERFACE","description":"Cable checked. Isolation switch armed. The BBS address waits in local memory.","prompt":"JACK IN?","choices":[{"id":&"JACK_IN","label":"JACK IN","description":"Open the local deck connection.","result_text":"The bedroom drops behind a field of carrier noise.","actions":[{"type":&"SET_FLAG","id":&"PROLOGUE_JACKED_IN"},{"type":&"SET_PHASE","value":&"BBS_OFFLINE"}]}]},{"id":&"BBS_DIALER","phase":&"BBS_OFFLINE","display_name":"BBS DIALER","description":"A hand-copied number for a small local hacker board.","prompt":"ESTABLISH CONNECTION","choices":[{"id":&"CONNECT_BBS","label":"CONNECT","description":"Dial the authored local board.","result_text":"Carrier lock. A plain text board resolves around you.","actions":[{"type":&"SET_FLAG","id":&"BBS_CONNECTED"},{"type":&"SET_PHASE","value":&"BBS_CONNECTED"}]}]},{"id":&"BBS_HELP_DESK","phase":&"BBS_CONNECTED","display_name":"LOCAL BBS // NEWCOMERS","description":"Posts, handles, and a blinking prompt asking what you need.","prompt":"POST A REQUEST","choices":[{"id":&"ASK_FOR_GUIDE","label":"ASK FOR SOMEONE TO SHOW YOU THE ROPES","description":"Request practical field guidance.","result_text":"Reply received: LATCH // I've got something small. Follow my carrier.","actions":[{"type":&"SET_FLAG","id":&"LATCH_CONTACTED"},{"type":&"COMPLETE_PROLOGUE"}]},{"id":&"READ_BOARD","label":"READ THE BOARD","description":"Browse local fragments before posting.","result_text":"Most of it is arguments, dead links, and people pretending not to advertise jobs.","actions":[{"type":&"SET_FLAG","id":&"BBS_READ"}]}]}]


